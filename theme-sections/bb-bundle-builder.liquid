  var CURATED=[
    {key:'most-popular',  label:'Most popular',     tags:['__best']},
    {key:'all',           label:'All wraps',        tags:['__all']},
    {key:'florals',       label:'Florals',          tags:['motif-floral','motif-roses','motif-tulips','motif-hydrangea','motif-peony-blossom','motif-botanical-trellis','motif-toile','motif-berries']},
    {key:'birthday',      label:'Birthday',         tags:['occasion-birthday','motif-balloons','motif-cakes-sweets','motif-party-hats']},
    {key:'wedding',       label:'Wedding & shower', tags:['occasion-wedding','occasion-bridal-shower','occasion-engagement','occasion-bachelorette','for-bridal','motif-wedding']},
    {key:'holiday',       label:'Holiday',          tags:['occasion-christmas','occasion-holiday-general','occasion-hanukkah','occasion-new-years','occasion-thanksgiving','motif-santa','motif-ornaments','motif-christmas-trees','motif-poinsettia-greenery','motif-candy-cane','motif-snowflakes','motif-gingerbread','motif-menorah']},
    {key:'valentines',    label:"Valentine's",      tags:['occasion-valentines','occasion-galentines','motif-hearts','motif-kiss-lips']},
    {key:'game-day',      label:'Game day',         tags:['occasion-gameday','occasion-game-day','motif-game-day','motif-sports-equipment','for-football','for-college-sports']},
    {key:'graduation',    label:'Graduation',       tags:['occasion-graduation','motif-graduation-cap']},
    {key:'baby',          label:'Baby shower',      tags:['occasion-baby','occasion-baby-shower']},
    {key:'halloween',     label:'Halloween',        tags:['occasion-halloween','motif-witch','motif-ghost','motif-spiderweb','motif-pumpkins']},
    {key:'bows',          label:'Bows',             tags:['motif-bows']},
    {key:'gingham-cane',  label:'Gingham & cane',   tags:['motif-gingham','motif-rattan-cane','motif-tartan-plaid','motif-argyle']},
    {key:'roses',         label:'Roses',            tags:['motif-roses']},
    {key:'coastal',       label:'Coastal',          tags:['style-coastal','motif-palm-tropical','motif-seashells','motif-nautical','motif-abstract-wave']},
    {key:'grand',         label:'Grandmillennial',  tags:['style-grandmillennial']},
    {key:'for-him',       label:'Gift for him',     tags:['for-menswear-dad','motif-menswear','for-golf','for-fishing','for-cars','for-football','for-college-sports','motif-western','for-equestrian','occasion-fathers-day']},
    {key:'for-golf',      label:'For the golfer',   tags:['for-golf']},
    {key:'for-racquet',   label:'Tennis & pickleball', tags:['for-tennis','for-pickleball']},
    {key:'for-mahjong',   label:'Mahjong night',    tags:['for-mahjong','motif-mahjong']},
    {key:'for-hostess',   label:'For the hostess',  tags:['for-hostess','for-entertaining-hostess','for-wine-bubbly','occasion-hostess','occasion-cocktail-party']}
  ];
  var activeCurated=CURATED[0].key;

  var PCSWAP={};
  try{var raw=JSON.parse((root.querySelector('[data-bb-pairs]').textContent||'[]'));raw.forEach(function(p){PCSWAP[p[0]]={b:'Prosecco',s:p[1],sb:'Champagne'};PCSWAP[p[1]]={b:'Champagne',s:p[0],sb:'Prosecco'};});}catch(e){}

  function money(c){return '$'+(c/100).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}
  function money0(c){return '$'+Math.round(c/100).toLocaleString();}
  function toCents(p){return Math.round(parseFloat(p)*100)||0;}
  function withW(src,w){if(!src)return '';return src+(src.indexOf('?')>-1?'&':'?')+'width='+w;}
  function abbr(b){return b==='Prosecco'?'Pros':(b==='Champagne'?'Champ':(b||''));}
  function cleanTitle(t){return (t||'').replace(/\s*(prosecco|champagne|veuve|la marca)\s*bottle wrap\s*$/i,'').replace(/\s*bottle wrap\s*$/i,'').trim();}
  function esc(t){return String(t==null?'':t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

  // free-wrap allotment per pack size (used for the size tiles / upgrade nudges)
  function freeFor(n){var f=0;if(n>=5)f=freeMap[5];if(n>=10)f=freeMap[10];if(n>=15)f=freeMap[15];if(n>15&&FREE_EXTRA>0)f=freeMap[15]+Math.floor((n-15)/5)*FREE_EXTRA;return f;}
  // SPEND-BASED ladder (mirrors the Free Wraps function): clean $39/$79/$119 dollar
  // thresholds — spend is all that matters (singles, minis, cart wraps all count),
  // exactly like it will in the cart at checkout. Wrap counts are irrelevant.
  function freeForSpend(c){var f=0;if(c>=T1)f=freeMap[5];if(c>=T2)f=freeMap[10];if(c>=T3)f=freeMap[15];if(c>T3&&FREE_EXTRA>0)f=freeMap[15]+Math.floor((c-T3)/TSTEP)*FREE_EXTRA;return f;}
  function spendAll(){return paidPrice()+minisTotal()+cartLooseCents;}   // ACTUAL eligible spend: builder wraps + minis + wraps already in the cart
  function goalCents(){return paidTarget>=15?T3:paidTarget>=10?T2:T1;}
  // GOAL-DRIVEN build: paid picks until the chosen tier's spend is reached, THEN free picks.
  // No mid-build interception at lower tiers (Shaun 2026-09-02).
  function goalMet(){return spendAll()>=goalCents();}
  function nextTierCents(){var sp=spendAll();return sp<T1?T1:sp<T2?T2:sp<T3?T3:0;}
  function freeCount(){return freeForSpend(spendAll());}
  // ANY single wrap can be a free pick — wine included (2026-09-02).
  function freeOK(bt,h){return true;}   // ANY single wrap can be a free pick (wine included 2026-09-02)
  // customer-facing tier names (5/10/15 are internal slot counts; shoppers see spend tiers)
  function tierName(n){return n===5?'Tier 1':n===10?'Tier 2':n===15?'Tier 3':(n+'-wrap bundle');}
  function tierCents(n){return n>=15?T3:n>=10?T2:T1;}
  // smallest pack that fits n wraps: 5/10/15, then 5-steps up to MAXPAID
  function fitTarget(n){return n<=5?5:n<=10?10:n<=15?15:Math.min(MAXPAID,Math.ceil(n/5)*5);}
  function syncSizeBtns(){root.querySelectorAll('.bb-bb-size').forEach(function(x){x.classList.toggle('is-active',parseInt(x.dataset.size,10)===paidTarget);});}
  function unlocked(){return freeCount()>0;}
  function freeActive(){return unlocked()?Math.min(free.length,freeCount()):0;}
  function totalWraps(){return paid.length+freeActive();}
  function paidPrice(){return paid.reduce(function(a,s){return a+(s.price||0);},0);}

  // pair helpers
  function swap(h){return PCSWAP[h]||null;}
  function bottleOf(h){var i=PCSWAP[h];return i?i.b:inferBottle(h);}
  function altSibling(h){var i=PCSWAP[h];return i?i.s:null;}
  function siblingForBottle(h,target){var i=PCSWAP[h];return (i&&i.sb===target)?i.s:null;}
  function inferBottle(h){h=(h||'').toLowerCase();if(h.indexOf('daou')>-1||h.indexOf('-wine')>-1)return 'Wine';if(h.indexOf('veuve')>-1||h.indexOf('champagne')>-1)return 'Champagne';if(h.indexOf('la-marca')>-1||h.indexOf('lamarca')>-1||h.indexOf('prosecco')>-1)return 'Prosecco';return currentBottle;}

  function isSingle(p){
    var h=(p.handle||'').toLowerCase(),v=p.variants&&p.variants[0];
    if(!v||!v.available)return false;
    if(/mini|bundle|six-pack|6-pack|set-of|tester|practice/.test(h))return false;
    // MUST mirror the Free Wraps discount function's band ($4–$8/unit) — anything outside
    // it would show as ladder-eligible here but be ignored by the checkout function.
    var c=toCents(v.price);return c>=400&&c<=800;
  }

  function seedCache(list){(list||[]).forEach(function(p){var v=p.variants&&p.variants[0];if(v&&!resolveCache.has(p.handle)){resolveCache.set(p.handle,{variantId:v.id,price:toCents(v.price),image:(p.images&&p.images[0]?p.images[0].src:''),title:p.title});}});}
  function resolve(h){
    if(resolveCache.has(h))return Promise.resolve(resolveCache.get(h));
    return fetch('/products/'+h+'.json').then(function(r){return r.json();}).then(function(d){
      var p=d.product,v=p.variants[0];var obj={variantId:v.id,price:toCents(v.price),available:(v.available!==false),image:(p.images&&p.images[0]?p.images[0].src:''),title:p.title};resolveCache.set(h,obj);return obj;
    });
  }

  // ---- discovery ----
  var GROUPS=[{k:'occasion',l:'Occasion'},{k:'style',l:'Style'}];
  var PRETTY={'self':'Me','gameday':'Game Day','baby':'Baby shower'};
  function prettyTag(t){var v=t.split('-').slice(1).join(' ');if(PRETTY[v])return PRETTY[v];return v.replace(/\b\w/g,function(m){return m.toUpperCase();});}
  function anyTags(){for(var k in activeTags){if(activeTags[k])return true;}return false;}
  function buildChips(){
    var counts={};
    pool.forEach(function(p){p._tags.forEach(function(t){var g=t.split('-')[0];if(g==='occasion'||g==='style'||g==='for'){counts[t]=(counts[t]||0)+1;}});});
    var caps={occasion:7,style:6,'for':4};chipData=[];
    GROUPS.forEach(function(grp){var arr=Object.keys(counts).filter(function(t){return t.split('-')[0]===grp.k;}).map(function(t){return {tag:t,group:grp.k,n:counts[t],label:prettyTag(t)};});arr.sort(function(a,b){return b.n-a.n;});chipData=chipData.concat(arr.slice(0,caps[grp.k]||6));});
  }
  function renderChips(){
    if(!chipsEl)return;
    chipsEl.innerHTML=GROUPS.map(function(grp){var items=chipData.filter(function(c){return c.group===grp.k;});if(!items.length)return '';return '<div class="bb-bb-chipgroup"><span class="bb-bb-chipgroup__l">'+grp.l+'</span>'+items.map(function(c){return '<button type="button" class="bb-bb-chip'+(activeTags[c.tag]?' is-active':'')+'" data-tag="'+c.tag+'">'+c.label+'</button>';}).join('')+'</div>';}).join('');
    chipsEl.querySelectorAll('.bb-bb-chip').forEach(function(b){b.addEventListener('click',function(){var t=b.dataset.tag;activeTags[t]=!activeTags[t];renderChips();renderGrid();});});
  }
  function matchActive(p){if(!anyTags())return true;var byG={};for(var t in activeTags){if(activeTags[t]){var g=t.split('-')[0];(byG[g]=byG[g]||[]).push(t);}}return Object.keys(byG).every(function(g){return byG[g].some(function(tt){return p._tags.indexOf(tt)>-1;});});}
  // word-PREFIX match (not raw substring) so "red" matches the word "red" / "color-red", NOT "featured"/"textured"/"gathered"
  var QSTOP={and:1,or:1,the:1,a:1,an:1,with:1,'for':1,of:1,'in':1,on:1,my:1,to:1};
  function tokenize(q){return (q||'').toLowerCase().split(/[^a-z0-9]+/).filter(function(t){return t&&!QSTOP[t];});}
  // a token matches by word-prefix OR inside the space-stripped text — so "cowgirl"
  // finds "Cow Girl" and "gameday" finds "Game Day" without relying on lucky tags
  function matchQuery(p){if(!qtokens.length)return true;return qtokens.every(function(tok){return p._words.some(function(w){return w.indexOf(tok)===0;})||p._joined.indexOf(tok)>-1;});}
  function scoreOf(p){var s=0;for(var t in activeTags){if(activeTags[t]&&p._tags.indexOf(t)>-1)s++;}if(qtokens.length){var ti=(p.title||'').toLowerCase();qtokens.forEach(function(tok){if(ti.indexOf(tok)>-1)s+=2;});}return s;}
  // curated starting-bundle pills (tag-driven); selecting one re-prefills that theme
  function renderCurated(){
    var els=root.querySelectorAll('[data-bb-curated]');if(!els.length)return;  // top row + mobile sheet
    var html=CURATED.map(function(c){return '<button type="button" class="bb-bb-preset'+(c.key===activeCurated?' is-active':'')+'" data-curated="'+c.key+'">'+c.label+'</button>';}).join('');
