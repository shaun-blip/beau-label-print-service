{%- comment -%}
  Beau Bottles — Build-a-Bundle (v4, SPEND-BASED)
  Free-wrap tiers are clean DOLLAR thresholds ($39/$79/$119 — just under 5/10/15 × unit price),
  mirroring the sitewide Free Wraps function: minis count toward the spend, testers
  don't, and any tier also unlocks free shipping. Packs remain the UI: pre-filled
  free slots, confetti unlock, "was $X" framing, "+ add more wraps" (no ceiling),
  size changes that KEEP your picks, checkout guard.
  Plus: editorial styling, Prosecco<->Champagne switching, discovery (search +
  filter chips), saved favorites, intent-ranked prefill, URL-seeded entry.

  Slot engine: two arrays — paid[] (target = chosen size, growable via "add more")
  and free[] (count = freeFor(paidTarget)). Switching is offered ONLY between
  single $5.95 wraps; mini/multipack SKUs are filtered out (separate Mini builder).
  Cart-critical variant id/price/image resolve live from same-origin
  /products/{handle}.json (never trusted from localStorage). Add-to-cart is a STUB.
{%- endcomment -%}

{%- assign bb_ws = false -%}
{%- if customer -%}{%- for bbwt in customer.tags -%}{%- assign bbwtl = bbwt | downcase -%}{%- if bbwtl contains 'wholesale' or bbwtl contains 'b2b' -%}{%- assign bb_ws = true -%}{%- endif -%}{%- endfor -%}{%- endif -%}
<section class="bb-bb{% if bb_ws %} bb-bb--ws{% endif %}"
  data-ws="{% if bb_ws %}1{% endif %}"
  data-default-size="{{ section.settings.default_size }}"
  data-default-bottle="{{ section.settings.default_bottle }}"
  data-source="{{ section.settings.source_collection }}"
  data-champagne="{{ section.settings.champagne_collection }}"
  data-wine="{% if section.settings.wine_collection %}{{ section.settings.wine_collection.handle }}{% endif %}"
  data-pbv="{{ section.settings.painted_bottle_value }}"
  data-free5="{{ section.settings.free_5 }}"
  data-free10="{{ section.settings.free_10 }}"
  data-free15="{{ section.settings.free_15 }}"
  data-free-extra="{{ section.settings.free_extra_per5 }}"
  data-max-paid="{{ section.settings.max_paid }}"
  data-ship="{{ section.settings.free_ship_threshold }}"
  data-grid-cap="{{ section.settings.grid_cap }}"
  data-minis="{% if section.settings.minis_collection %}{{ section.settings.minis_collection.handle }}{% else %}mini-la-marca{% endif %}">

  <script type="application/json" data-bb-pairs>{% render 'bb-pc-pairs' %}</script>

  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&display=swap">
  <div class="bb-bb-inner">
    <style>
      .bb-bb-back{display:inline-flex;align-items:center;gap:5px;margin:0 0 14px;font-family:'Jost',system-ui,sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.02em;color:#7A8699;text-decoration:none;transition:color .15s}
      .bb-bb-back:hover{color:#2B2F3D}
      .bb-bb-back svg{width:16px;height:16px;flex:0 0 auto}
    </style>
    <a class="bb-bb-back" data-bb-back href="{{ section.settings.shop_url | default: '/collections/all' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>Continue shopping</a>
    <header class="bb-bb-head">
      {%- if section.settings.heading != blank -%}<h1 class="bb-bb-heading">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="bb-bb-sub">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.show_trust -%}<p class="bb-bb-trustbar"><span class="bb-bb-trustbar__rating">★ {{ section.settings.trust_rating }}</span> · {{ section.settings.trust_reviews }}+ verified reviews · {{ section.settings.trust_customers }}+ happy customers</p>{%- endif -%}
    </header>

    {%- comment -%} SSR pricing: derive the wrap unit price from the pool collection (same $4–8
        band as the checkout function) so tiers render real numbers before JS — no "—" flash,
        and crawlers see prices. JS re-verifies against the live pool after load. {%- endcomment -%}
    {%- assign bb_unit = 795 -%}
    {%- assign bb_src = section.settings.source_collection | default: collections['la-marca-wraps'] -%}
    {%- for bb_p in bb_src.products limit: 12 -%}
      {%- if bb_p.price >= 400 and bb_p.price <= 800 -%}{%- assign bb_unit = bb_p.price -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    <!-- ENTRY SIMPLIFIED 2026-09: the old "Step 1: Pick your tier" gate forced a $39–$119 spend
         commitment before the shopper saw a single wrap — the top bounce driver (builder scroll
         depth ~50%). It's now a plain-language intro + an OPTIONAL, collapsed reward ladder, so the
         first action is pick-a-bottle -> add wraps. Every tier element + data attribute is intact
         (the tile JS and the AOV/discount mechanic are unchanged); the live spend meter lower down
         still teaches the reward dynamically as wraps are added. -->
    <p class="bb-bb-intro">Pick a bottle, then add the wraps you love — <b>free wraps unlock as you spend</b>: $39 gets 2, $79 gets 5, $119 gets 10. Choose your free designs and they ring up <b>$0 at checkout</b>. No code.</p>
    {%- if bb_ws -%}<p class="bb-bb-elignote">Wholesale accounts aren’t eligible for the free-wrap promotion — wholesale pricing applies instead.</p>{%- endif -%}
    <details class="bb-bb-goal" data-step="01">
      <summary class="bb-bb-goal__sum"><span class="bb-bb-goal__q">Want to aim for a tier?</span> See how the free wraps stack up <span class="bb-bb-goal__opt">optional</span></summary>
      <div class="bb-bb-sizes" role="tablist" aria-label="Bundle tier">
        {%- assign sizes = '5,10,15' | split: ',' -%}
        {%- for s in sizes -%}
          <button class="bb-bb-size{% if s == section.settings.default_size %} is-active{% endif %}" data-size="{{ s }}" role="tab">
            {%- if s == '10' -%}<span class="bb-bb-size__tag">Most popular</span>{%- elsif s == '15' -%}<span class="bb-bb-size__tag bb-bb-size__tag--alt">Best value</span>{%- endif -%}
            <span class="bb-bb-size__n">Tier {{ forloop.index }}</span>
            {%- assign s_n = s | plus: 0 -%}
            {%- case s -%}{%- when '5' -%}{%- assign s_free = section.settings.free_5 | default: 2 -%}{%- when '10' -%}{%- assign s_free = section.settings.free_10 | default: 5 -%}{%- else -%}{%- assign s_free = section.settings.free_15 | default: 10 -%}{%- endcase -%}
            {%- case s -%}{%- when '5' -%}{%- assign s_tier = 3900 -%}{%- when '10' -%}{%- assign s_tier = 7900 -%}{%- else -%}{%- assign s_tier = 11900 -%}{%- endcase -%}
            {%- assign s_was = s_n | plus: s_free | times: bb_unit -%}
            <span class="bb-bb-size__pwrap"><span class="bb-bb-size__p" data-size-price="{{ s }}">Spend {{ s_tier | money_without_trailing_zeros }}</span></span>
            <span class="bb-bb-size__free" data-size-free="{{ s }}">{% if s_free > 0 %}Get {{ s_free }} FREE wrap{% if s_free > 1 %}s{% endif %}{% endif %}</span>
            <span class="bb-bb-size__worth" data-size-worth="{{ s }}">{% if s_free > 0 %}a {{ s_free | times: bb_unit | money }} value{% endif %}</span>
            <span class="bb-bb-size__ship">Free shipping</span>
          </button>
        {%- endfor -%}
      </div>
    </details>
    <style>.bb-bb--ws .bb-bb-size__free,.bb-bb--ws .bb-bb-size__worth,.bb-bb--ws .bb-bb-size__ship{display:none}</style>
    <style>
      .bb-bb-intro{margin:0 auto 14px;max-width:640px;text-align:center;font-family:'Jost',system-ui,sans-serif;font-size:14px;line-height:1.55;color:#4A4A4A}
      .bb-bb-intro b{color:var(--ink);font-weight:700}
      .bb-bb-elignote{margin:8px 2px 12px;font-family:'Jost',system-ui,sans-serif;font-size:12px;line-height:1.5;color:#7A8699}
      .bb-bb-goal{margin:0 auto 6px;max-width:640px;border:1px solid rgba(43,47,61,.12);border-radius:14px;background:#fff}
      .bb-bb-goal[open]{padding-bottom:16px}
      .bb-bb-goal__sum{list-style:none;cursor:pointer;padding:13px 16px;font-family:'Jost',system-ui,sans-serif;font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
      .bb-bb-goal__sum::-webkit-details-marker{display:none}
      .bb-bb-goal__sum::after{content:'▾';margin-left:auto;color:#7A8699;transition:transform .2s}
      .bb-bb-goal[open] .bb-bb-goal__sum::after{transform:rotate(180deg)}
      .bb-bb-goal__q{font-weight:700;color:var(--ink)}
      .bb-bb-goal__opt{font-size:10.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#9aa3b2;background:#f2f0ec;border-radius:999px;padding:2px 9px}
      .bb-bb-goal .bb-bb-sizes{padding:0 14px}
      .bb-bb-size .bb-bb-size__free{display:block;margin-top:9px;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#C9898D;text-align:center}
      .bb-bb-size.is-active .bb-bb-size__free{color:#f6bdd5}
      .bb-bb-size__worth{display:block;margin-top:1px;font-family:'Jost',system-ui,sans-serif;font-size:11px;font-weight:600;color:#7A8699;text-align:center}
      .bb-bb-size.is-active .bb-bb-size__worth{color:rgba(255,255,255,.75)}
      .bb-bb-size .bb-bb-size__ship{display:block;margin-top:4px;font-size:10.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#7A8699;text-align:center}
      .bb-bb-size.is-active .bb-bb-size__ship{color:rgba(255,255,255,.85)}
    </style>

    {% render 'fitment-popup', modal_only: true %}
    <div class="bb-bb-flipbar" data-bb-flip hidden></div>

    {%- comment -%} Pre-built gift sets REMOVED 2026-09 (unused, took space, confused the flow).
        ?preset= deep links from old ads/emails degrade gracefully to a plain builder.
        The dormant SETS/applySet JS stays for now; the schema block + template blocks are gone.
        Step 2 (bottle type) now lives INSIDE the grid column, sticky, so switching bottles
        never requires scrolling away from the wraps (Shaun 2026-09). {%- endcomment -%}

    <!-- step 2: bottle type — STICKY so switching never requires scrolling away from the grid -->
    <div class="bb-bb-step bb-bb-step--bottle" data-step="01">
      <div class="bb-bb-bottlebar">
        <p class="bb-bb-steplbl bb-bb-steplbl--bottle"><span class="bb-bb-steplbl__n">1</span> What are you wrapping?</p>
        <div class="bb-bb-bottle__opts" role="group" aria-label="Bottle type">
          <button type="button" class="bb-bb-bottle__opt{% if section.settings.default_bottle == 'Prosecco' %} is-active{% endif %}" data-bottle="Prosecco">Prosecco</button>
          <button type="button" class="bb-bb-bottle__opt{% if section.settings.default_bottle == 'Champagne' %} is-active{% endif %}" data-bottle="Champagne">Champagne</button>
          <button type="button" class="bb-bb-bottle__opt" data-bottle="Mini">Mini</button>
          {%- if section.settings.enable_wine -%}<button type="button" class="bb-bb-bottle__opt{% if section.settings.default_bottle == 'Wine' %} is-active{% endif %}" data-bottle="Wine">Wine</button>{%- endif -%}
        </div>
        <button type="button" class="bb-bb-fitlink" data-bb-fit aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Will these fit my bottle?
        </button>
      </div>
    </div>
    <style>
      .bb-bb-step--bottle{position:sticky;top:0;z-index:40;background:rgba(250,247,242,.96);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);padding:10px 0 8px;margin:0 0 4px;border-bottom:1px solid rgba(43,47,61,.07)}
      .bb-bb-bottlebar{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
      .bb-bb-steplbl--bottle{margin:0;white-space:nowrap}
      .bb-bb-bottlebar .bb-bb-bottle__opts{background:#fff;border:1.5px solid rgba(43,47,61,.14);border-radius:999px;padding:4px;box-shadow:0 2px 10px rgba(43,47,61,.08)}
      .bb-bb-bottlebar .bb-bb-bottle__opt{font-size:14.5px;font-weight:700;padding:11px 26px;min-height:46px}
      .bb-bb-bottlebar .bb-bb-bottle__opt.is-active{background:#2B2F3D;color:#fff;border-radius:999px}
      .bb-bb-bottlebar .bb-bb-fitlink{margin-left:auto}
      @media(max-width:600px){
        .bb-bb-bottlebar{gap:8px}
        .bb-bb-bottlebar .bb-bb-fitlink{margin-left:0;flex-basis:100%}
        /* the pill row must FIT the phone: four options measured 453px and forced the whole page
           to lay out ~470px wide at 390px, shrinking every tap target (verified 2026-11) */
        .bb-bb-bottlebar .bb-bb-bottle__opts{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;display:flex;flex-wrap:nowrap;scrollbar-width:none}
        .bb-bb-bottlebar .bb-bb-bottle__opts::-webkit-scrollbar{display:none}
        .bb-bb-bottlebar .bb-bb-bottle__opt{font-size:13.5px;padding:10px 16px;min-height:44px;white-space:nowrap;flex:0 0 auto}
      }
    </style>

    <!-- step 3 label sits above the picking area -->
    <p class="bb-bb-steplbl bb-bb-steplbl--fill"><span class="bb-bb-steplbl__n">2</span> Add the wraps you love <em class="bb-bb-steplbl__hint">— tap a wrap or mini set to add it</em></p>

    <!-- saved favorites (hidden until something is saved) -->
    <div class="bb-bb-faves" data-bb-faves hidden>
      <div class="bb-bb-faves__top">
        <span class="bb-bb-faves__t"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 12.55 12 20.05l-7.5-7.5a4.6 4.6 0 0 1 6.5-6.5l1 1 1-1a4.6 4.6 0 0 1 6.5 6.5z"/></svg> Your saved favorites</span>
        <span class="bb-bb-faves__how">Tap ♥ on wraps you love — they’ll appear here to add fast.</span>
      </div>
      <div class="bb-bb-faves__row" data-bb-faves-row></div>
    </div>

    <div class="bb-bb-grid-tray">
      <div class="bb-bb-grid-wrap">
        <button class="bb-bb-findbar" data-bb-sheet-toggle type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Search or jump to a theme</span>
        </button>
        <div class="bb-bb-discover">
          <div class="bb-bb-searchrow">
            <div class="bb-bb-search">
              <svg class="bb-bb-search__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="search" class="bb-bb-search__in" data-bb-search placeholder="Search — try “wedding”, “game day”, “floral”" aria-label="Search wraps">
              <button type="button" class="bb-bb-search__clear" data-bb-search-clear hidden aria-label="Clear search">×</button>
            </div>

          </div>
          <div class="bb-bb-themes" data-bb-themes>
            <div class="bb-bb-presets" data-bb-curated></div>
          </div>
          <div class="bb-bb-resultcount" data-bb-resultcount></div>
        </div>
        <div class="bb-bb-scope" data-bb-scope hidden>
          <span class="bb-bb-scope__t" data-bb-scope-text></span>
          <button type="button" class="bb-bb-scope__b" data-bb-scope-all>Search all wraps →</button>
        </div>
        <div class="bb-bb-grid" data-bb-grid aria-live="polite">
          <div class="bb-bb-grid__loading">Loading wraps…</div>
        </div>
        <p class="bb-bb-help">Each wrap in your bundle shows the bottle it’s for. If a design comes in both, tap the <strong>⇄</strong> on it to switch between Prosecco and Champagne.</p>

        {%- comment -%} Mini-sets rail removed 2026-09: minis are cards in the main grid and
            slot into the tray like wraps (their spend still raises the free tier). {%- endcomment -%}
        <style>
          .bb-bb-card--mini .bb-bb-card__imgw{background:#FBF6F1}
          .bb-bb-card__minitag{display:block;margin:6px 0 0;font-family:'Jost',system-ui,sans-serif;font-size:9.5px;font-weight:800;letter-spacing:.08em;color:#C9898D}
          .bb-bb-slot--mini{outline:1.5px dashed rgba(201,137,141,.55);outline-offset:-1.5px}
          .bb-bb-slot__minitag{position:absolute;left:4px;bottom:4px;font-family:'Jost',system-ui,sans-serif;font-size:8.5px;font-weight:800;letter-spacing:.07em;color:#fff;background:#C9898D;border-radius:3px;padding:1px 4px}
          .bb-bb-slot__qty{position:absolute;right:4px;bottom:4px;font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:800;color:#2B2F3D;background:#fff;border-radius:999px;padding:1px 6px;box-shadow:0 1px 4px rgba(43,47,61,.25)}
        </style>
      </div>

      <div class="bb-bb-traydim" data-tray-close aria-hidden="true"></div>
      <aside class="bb-bb-tray" data-bb-tray>
        <button type="button" class="bb-bb-tray__grab" data-tray-close aria-label="Close your bundle panel"><span class="bb-bb-tray__grabbar" aria-hidden="true"></span><span class="bb-bb-tray__grabtxt">Close ▾</span></button>
        <div class="bb-bb-confetti" data-bb-confetti aria-hidden="true"></div>
        <div class="bb-bb-tray__head">
          <span class="bb-bb-tray__title" data-bb-tray-title>Your bundle</span>
          <button class="bb-bb-clearall" data-bb-clearall type="button" hidden>Clear all &amp; start fresh</button>
        </div>
        {%- comment -%} Tray v5 (spend model, rebuilt): a clean ITEM LIST (never empty boxes),
            ONE spend meter as the single message, a free-picks section that exists only
            once earned, and a one-line painted-bottle note. {%- endcomment -%}
        <div class="bb-bb-items" data-bb-slots></div>
        <div class="bb-bb-spend" data-bb-spend hidden>
          <div class="bb-bb-spend__bar"><i data-bb-spend-fill></i></div>
          <div class="bb-bb-spend__txt" data-bb-spend-txt></div>
        </div>
        <button class="bb-bb-fillrest" data-bb-fillrest type="button" hidden>✨ Fill the rest for me</button>
        <div class="bb-bb-ship" data-bb-ship></div>
        <div class="bb-bb-valueline" data-bb-valueline hidden></div>
        <style>
          .bb-bb-items{display:flex;flex-direction:column;gap:6px;margin:0 0 14px}
          .bb-it{display:flex;align-items:center;gap:10px;padding:7px 8px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:10px}
          .bb-it img{width:42px;height:42px;object-fit:contain;border-radius:6px;background:#fff;flex:0 0 auto}
          .bb-it__m{flex:1;min-width:0;display:flex;flex-direction:column;line-height:1.25}
          .bb-it__t{font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:700;color:#F5F0E6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
          .bb-it__s{font-family:var(--baseFont,system-ui,sans-serif);font-size:10.5px;font-weight:600;color:rgba(245,240,230,.55)}
          .bb-it__p{font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:800;color:#F5F0E6;white-space:nowrap}
          .bb-it__p s{color:rgba(245,240,230,.45);font-weight:600;margin-right:4px}
          .bb-it__p .is-free{color:#C9A961}
          .bb-it__x{flex:0 0 auto;width:24px;height:24px;border:none;border-radius:50%;background:rgba(255,255,255,.1);color:rgba(245,240,230,.7);font-size:14px;line-height:1;cursor:pointer}
          .bb-it__x:hover{background:rgba(255,255,255,.2);color:#fff}
          .bb-it__seg{flex:0 0 auto;display:inline-flex;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:2px}
          .bb-it__seg__b{border:none;background:transparent;color:rgba(245,240,230,.55);font-family:var(--baseFont,system-ui,sans-serif);font-size:10.5px;font-weight:800;letter-spacing:.03em;padding:4px 9px;border-radius:999px;cursor:pointer}
          .bb-it__seg__b.is-on{background:#C9A961;color:#2B2F3D;cursor:default}
          .bb-it__seg__b:not(.is-on):hover{color:#fff}
          .bb-it__step{display:inline-flex;align-items:center;gap:6px}
          .bb-it__step button{width:22px;height:22px;border:none;border-radius:50%;background:rgba(255,255,255,.12);color:#F5F0E6;font-size:13px;line-height:1;cursor:pointer}
          .bb-it__step span{font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;font-weight:800;color:#F5F0E6;min-width:14px;text-align:center}
          .bb-it--free{border-style:dashed;border-color:rgba(201,169,97,.5)}
          .bb-it--empty{justify-content:center;padding:18px 10px;border-style:dashed;color:rgba(245,240,230,.6);font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:600;text-align:center;cursor:default}
          .bb-it--cart{opacity:.72}
          .bb-tl--cart .bb-tl__imgw{border-style:solid;border-color:rgba(147,174,197,.5)}
          .bb-tl--cart img{opacity:.85}
          .bb-tl__carttag{position:absolute;left:2px;bottom:2px;font-family:var(--baseFont,system-ui,sans-serif);font-size:7px;font-weight:800;letter-spacing:.05em;color:#fff;background:#5E7C97;border-radius:3px;padding:1px 3px}
          .bb-it-sec--cart{justify-content:center;margin:0 0 8px}
          .bb-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:7px;margin:4px 0 8px}
          .bb-tl{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:0}
          .bb-tl__imgw{position:relative;display:block;width:100%;aspect-ratio:1;background:#fff;border-radius:8px;overflow:hidden;cursor:zoom-in;border:1px solid rgba(255,255,255,.1)}
          .bb-tl__imgw img{width:100%;height:100%;object-fit:contain;display:block}
          .bb-tl--free .bb-tl__imgw{border:1.5px dashed rgba(246,189,213,.75)}
          .bb-tl__freetag{position:absolute;left:2px;bottom:2px;font-family:var(--baseFont,system-ui,sans-serif);font-size:7.5px;font-weight:800;letter-spacing:.06em;color:#2B2F3D;background:#f6bdd5;border-radius:3px;padding:1px 3px}
          .bb-tl__minitag{position:absolute;left:2px;bottom:2px;font-family:var(--baseFont,system-ui,sans-serif);font-size:7.5px;font-weight:800;letter-spacing:.06em;color:#fff;background:#C9898D;border-radius:3px;padding:1px 3px}
          .bb-tl__qty{position:absolute;right:2px;bottom:2px;font-family:var(--baseFont,system-ui,sans-serif);font-size:9px;font-weight:800;color:#2B2F3D;background:#fff;border-radius:999px;padding:0 4px;box-shadow:0 1px 3px rgba(43,47,61,.3)}
          .bb-tl__x{position:absolute;top:2px;right:2px;width:17px;height:17px;border:none;border-radius:50%;background:rgba(43,47,61,.55);color:#fff;font-size:11px;line-height:1;cursor:pointer;padding:0}
          .bb-tl__x:hover{background:rgba(43,47,61,.85)}
          .bb-tl__sw{border:none;background:none;color:rgba(245,240,230,.6);font-family:var(--baseFont,system-ui,sans-serif);font-size:8.5px;font-weight:700;letter-spacing:.03em;cursor:pointer;padding:0;white-space:nowrap}
          .bb-tl__sw--btn{border:1px solid rgba(147,174,197,.55);border-radius:999px;padding:2px 7px;font-size:9px;font-weight:800;color:#93AEC5;background:rgba(147,174,197,.08)}
          .bb-tl__sw--btn:hover{background:rgba(147,174,197,.22);color:#fff}
          .bb-tl__ft{color:rgba(245,240,230,.45);font-family:var(--baseFont,system-ui,sans-serif);font-size:8.5px;font-weight:700;letter-spacing:.03em;white-space:nowrap}
          .bb-tl__spin{position:absolute;inset:0;background:rgba(255,255,255,.4)}
          .bb-it-sec{margin:10px 0 2px;display:flex;align-items:baseline;justify-content:space-between}
          .bb-it-sec__t{font-family:var(--baseFont,system-ui,sans-serif);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#C9A961}
          .bb-it-sec__s{font-family:var(--baseFont,system-ui,sans-serif);font-size:11px;font-weight:600;color:rgba(245,240,230,.6)}
          .bb-bb-spend{margin:0 0 12px}
          .bb-bb-spend[hidden]{display:none}
          .bb-bb-spend__bar{position:relative;height:8px;border-radius:999px;background:rgba(255,255,255,.12);overflow:hidden}
          .bb-bb-spend__bar i{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,#C9A961,#f6bdd5);transition:width .35s cubic-bezier(.2,.8,.2,1)}
          .bb-bb-spend__txt{margin-top:7px;font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:600;line-height:1.5;color:rgba(245,240,230,.9);text-align:center}
          .bb-bb-spend__txt b{color:#C9A961}
          .bb-bb-valueline{margin:10px 0 0;font-family:var(--baseFont,system-ui,sans-serif);font-size:11.5px;font-weight:600;color:rgba(245,240,230,.6);text-align:center}
          .bb-bb-valueline[hidden]{display:none}
          .bb-bb-valueline b{color:#C9A961}
        </style>

        <div class="bb-bb-guard" data-bb-guard hidden></div>
        <p class="bb-bb-note" data-bb-note></p>
        {%- if section.settings.show_trust -%}<p class="bb-bb-atctrust">{{ section.settings.guarantee_text }} · Secure checkout</p>{%- endif -%}
        <div class="bb-bb-atcdock">
          <button type="button" class="bb-bb-add" data-bb-add disabled>Add bundle to cart</button>
          <div class="bb-bb-savenote" data-bb-savenote hidden></div>
          <div class="bb-bb-added" data-bb-added hidden>Added to your cart &middot; <a href="/cart">View cart &rarr;</a></div>
        </div>
        <style>.bb-bb-added{margin:10px 0 0;padding:11px 14px;background:rgba(169,195,164,.15);border:1px solid rgba(169,195,164,.4);border-radius:10px;font-family:var(--baseFont,system-ui,sans-serif);font-size:13px;font-weight:700;color:#A9C3A4;text-align:center}.bb-bb-added[hidden]{display:none}.bb-bb-added a{color:#F5F0E6;text-decoration:underline;text-underline-offset:2px}</style>
        <style>.bb-bb-savenote{margin:8px 0 0;font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:700;color:#A9C3A4;text-align:center}.bb-bb-savenote[hidden]{display:none}.bb-bb-savenote b{color:#C9A961}</style>
        <style>
          .bb-bb-atcdock{position:sticky;bottom:-1px;z-index:6;background:inherit;margin:0 -24px;padding:10px 24px 14px;box-shadow:0 -12px 18px -8px rgba(23,26,34,.3)}
          @media (max-width:800px){.bb-bb-atcdock{padding-bottom:calc(14px + env(safe-area-inset-bottom,0px))}}
        </style>
      </aside>
    </div>

  </div>

  <!-- mobile-only sticky summary / cart bar -->
  <div class="bb-bb-stickybar" data-bb-stickybar>
    <button type="button" class="bb-bb-stickybar__info" data-tray-toggle aria-expanded="false" aria-label="View your bundle">
      <span class="bb-bb-stickybar__count" data-bb-sticky-count>0 / 10</span>
      <span class="bb-bb-stickybar__sub" data-bb-sticky-sub></span>
      <span class="bb-bb-stickybar__chev">Your bundle ▴</span>
    </button>
    <button class="bb-bb-stickybar__find" data-bb-sheet-toggle type="button" aria-label="Find more wraps">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <span>Find wraps</span>
    </button>
    <button class="bb-bb-stickybar__btn" data-bb-sticky-cta type="button" hidden>Add to cart</button>
  </div>

  <div class="bb-bb-zoom" data-bb-zoom hidden>
    <button class="bb-bb-zoom__x" data-bb-zoom-close type="button" aria-label="Close">×</button>
    <figure class="bb-bb-zoom__fig"><span class="bb-bb-zoom__stage"><img data-bb-zoom-img src="" alt="">
      <div class="bb-bb-zoom__spin" data-bb-zoom-spin hidden><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 2v6h-6"/><path d="M2.5 22v-6h6"/><path d="M2 11.5a10 10 0 0 1 18.8-4.3"/><path d="M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>360&deg;</div>
      <div class="bb-bb-zoom__hint" data-bb-zoom-hint hidden>Drag to spin</div>
    </span><figcaption class="bb-bb-zoom__cap" data-bb-zoom-cap></figcaption>
    <button type="button" class="bb-bb-zoom__switch" data-bb-zoom-switch hidden></button>
    <button type="button" class="bb-bb-zoom__remove" data-bb-zoom-remove hidden></button>
    <style>.bb-bb-zoom__switch,.bb-bb-zoom__remove{margin:12px auto 0;display:block;padding:12px 26px;border:1.5px solid rgba(255,255,255,.5);border-radius:999px;background:rgba(255,255,255,.08);color:#fff;font-family:var(--baseFont,system-ui,sans-serif);font-size:13.5px;font-weight:700;letter-spacing:.03em;cursor:pointer}.bb-bb-zoom__switch:hover{background:rgba(255,255,255,.2)}.bb-bb-zoom__switch[hidden]{display:none}.bb-bb-zoom__remove{border-color:rgba(233,150,156,.7);color:#F3B6BB}.bb-bb-zoom__remove:hover{background:rgba(233,150,156,.15)}.bb-bb-zoom__remove[hidden]{display:none}</style></figure>
  </div>


  <!-- mobile discovery bottom-sheet: search + theme pills, reachable without scrolling up -->
  <div class="bb-bb-sheet" data-bb-sheet hidden>
    <div class="bb-bb-sheet__backdrop" data-bb-sheet-close></div>
    <div class="bb-bb-sheet__panel" role="dialog" aria-label="Find wraps">
      <span class="bb-bb-sheet__grip" aria-hidden="true"></span>
      <div class="bb-bb-sheet__head">
        <span class="bb-bb-sheet__title">Search or pick a theme</span>
        <button class="bb-bb-sheet__done" data-bb-sheet-close type="button">Done</button>
      </div>
      <div class="bb-bb-sheet__row">
        <span class="bb-bb-sheet__lbl">I'm wrapping</span>
        <div class="bb-bb-bottle__opts" role="group" aria-label="Bottle type">
          <button type="button" class="bb-bb-bottle__opt{% if section.settings.default_bottle == 'Prosecco' %} is-active{% endif %}" data-bottle="Prosecco">Prosecco</button>
          <button type="button" class="bb-bb-bottle__opt{% if section.settings.default_bottle == 'Champagne' %} is-active{% endif %}" data-bottle="Champagne">Champagne</button>
          <button type="button" class="bb-bb-bottle__opt" data-bottle="Mini">Mini</button>
          {%- if section.settings.enable_wine -%}<button type="button" class="bb-bb-bottle__opt{% if section.settings.default_bottle == 'Wine' %} is-active{% endif %}" data-bottle="Wine">Wine</button>{%- endif -%}
        </div>
      </div>
      <input type="search" class="bb-bb-sheet__in" data-bb-sheet-search placeholder="Search — “floral”, “game day”, “bows”…" aria-label="Search wraps">
      <div class="bb-bb-sheet__pills" data-bb-curated></div>
    </div>
  </div>
</section>

<style>
  .bb-bb{--rose:#D49A9D;--rose-deep:#C9898D;--rose-soft:#F6E7E8;--rose-tint:#FFF3F1;--ink:#2B2F3D;--muted:#7A8699;--cream:#FAF6F0;--cream-deep:#F2EBE0;--blue:#93AEC5;--blue-deep:#7E9DB8;--line:rgba(43,47,61,.10);background:var(--cream);padding:clamp(40px,5vw,80px) clamp(16px,4vw,40px)}
  .bb-bb *{box-sizing:border-box}
  .bb-bb-inner{max-width:1200px;margin:0 auto}
  .bb-bb-head{text-align:center;margin:0 auto 20px;max-width:680px}
  .bb-bb-eyebrow{font-family:var(--baseFont,system-ui,sans-serif);font-size:11px;font-weight:500;letter-spacing:.3em;text-transform:uppercase;color:var(--rose);margin:0 0 10px}
  .bb-bb-heading{font-family:var(--titleFont,Georgia,serif);font-size:clamp(28px,3.6vw,44px);font-weight:400;line-height:1.08;letter-spacing:-.01em;color:var(--ink);margin:0 0 10px;text-wrap:balance}
  .bb-bb-sub{font-family:var(--baseFont,system-ui,sans-serif);font-size:16px;line-height:1.55;color:var(--muted);margin:0}
  .bb-bb-trustbar{font-family:var(--baseFont,system-ui,sans-serif);font-size:13px;color:var(--muted);margin:10px 0 0;letter-spacing:.01em}
  .bb-bb-trustbar__rating{font-weight:800;color:var(--ink)}
  .bb-bb-size__ship{display:block;font-size:9px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#5E7C97;margin-top:3px}
  .bb-bb-size.is-active .bb-bb-size__ship{color:#fff}
  .bb-bb-atctrust{font-family:var(--baseFont,system-ui,sans-serif);font-size:11.5px;font-weight:600;color:var(--muted);text-align:center;margin:9px 0 0;letter-spacing:.02em}
  /* numbered step spine */
  .bb-bb-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:clamp(22px,3vw,40px) clamp(20px,2.8vw,38px) clamp(18px,2.4vw,32px);margin:0 0 20px;box-shadow:0 2px 12px rgba(43,47,61,.04)}
  .bb-bb-grid-wrap{background:#fff;border:1px solid var(--line);border-radius:18px;padding:clamp(18px,2.4vw,32px);box-shadow:0 2px 12px rgba(43,47,61,.04)}
  .bb-bb-steplbl{display:flex;align-items:center;justify-content:center;gap:9px;font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);margin:0 0 14px}
  .bb-bb-steplbl__n{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--rose);color:var(--ink);font-size:12px;font-weight:800;letter-spacing:0;flex-shrink:0}
  .bb-bb-steplbl__hint{font-style:normal;font-weight:600;letter-spacing:.02em;text-transform:none;color:var(--muted)}
  .bb-bb-steplbl--fill{margin:28px 0 16px}
  /* bottle context */
  .bb-bb-bottle{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px;margin:0 0 16px}
  .bb-bb-bottle__lbl{font-family:var(--baseFont,system-ui,sans-serif);font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
  .bb-bb-bottle__opts{display:inline-flex;background:#fff;border:1px solid var(--line);border-radius:999px;padding:4px}
  .bb-bb-bottle__opt{font-family:var(--baseFont,system-ui,sans-serif);font-size:13px;font-weight:600;color:var(--ink);background:transparent;border:none;border-radius:999px;padding:9px 22px;cursor:pointer;transition:all .18s;min-height:40px}
  .bb-bb-bottle__opt.is-active{background:var(--rose);color:var(--ink)}
  .bb-bb-bottle__mini{font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;color:var(--rose-deep);text-decoration:underline;text-underline-offset:3px}
  .bb-bb-fitlink{flex-basis:100%;display:inline-flex;align-items:center;justify-content:center;gap:6px;margin:2px 0 0;background:none;border:none;padding:0;cursor:pointer;font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:600;color:var(--blue-deep);text-decoration:underline;text-underline-offset:3px}
  .bb-bb-fitlink svg{width:15px;height:15px;flex-shrink:0}
  .bb-bb-fitlink:hover{color:var(--ink)}
  .bb-bb-flipbar{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px;background:#fff;border:1px solid var(--rose);border-radius:12px;padding:12px 16px;margin:0 auto 18px;max-width:580px;font-family:var(--baseFont,system-ui,sans-serif);font-size:13px;line-height:1.4;color:var(--ink);box-shadow:0 4px 18px rgba(212,154,157,.18)}
  .bb-bb-flipbar button{font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.04em;border-radius:8px;padding:9px 16px;cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink)}
  .bb-bb-flipbar button.is-go{background:var(--rose);border-color:var(--rose)}
  .bb-bb-flipbar[hidden]{display:none}
  /* size selector */
  .bb-bb-sizes{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:0 0 12px}
  .bb-bb-size{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;min-width:96px;font-family:var(--baseFont,system-ui,sans-serif);color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px 15px 10px;cursor:pointer;transition:all .2s;box-shadow:0 1px 6px rgba(43,47,61,.04)}
  .bb-bb-size:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(43,47,61,.1)}
  .bb-bb-size.is-active{background:var(--blue);border-color:var(--blue);color:#fff}
  .bb-bb-size__n{font-size:15px;font-weight:700;letter-spacing:.01em}
  .bb-bb-size__pwrap{display:flex;align-items:baseline;justify-content:center;gap:6px}
  .bb-bb-size__was{font-size:12px;color:var(--muted);text-decoration:line-through}
  .bb-bb-size.is-active .bb-bb-size__was{color:rgba(255,255,255,.75)}
  .bb-bb-size__p{font-size:14px;font-weight:700;color:var(--ink)}
  .bb-bb-size.is-active .bb-bb-size__p{color:#fff}
  .bb-bb-size__free{font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#2e7d57}
  .bb-bb-size.is-active .bb-bb-size__free{color:#fff}
  .bb-bb-size__tag{position:absolute;top:-10px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--rose);color:var(--ink);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:999px}
  .bb-bb-size__tag--alt{background:var(--ink);color:#fff}
  .bb-bb-nudge{font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;font-weight:600;color:var(--rose-deep);text-align:center;margin:0 0 12px;line-height:1.45}
  .bb-bb-nudge:empty{display:none}
  /* discovery: search row + collapsible themes */
  .bb-bb-searchrow{display:flex;gap:10px;align-items:stretch;margin:0 0 12px}
  .bb-bb-searchrow .bb-bb-search{flex:1;margin:0}
  .bb-bb-themesbtn{font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:700;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:10px;padding:0 16px;cursor:pointer;white-space:nowrap;transition:all .15s}
  .bb-bb-themesbtn:hover,.bb-bb-themesbtn.is-open{border-color:var(--rose)}
  .bb-bb-themesbtn.is-open{background:var(--rose-tint)}
  .bb-bb-themes{margin:0 0 12px}
  .bb-bb-themes[hidden]{display:none}
  .bb-bb-themes .bb-bb-presets{margin:0;justify-content:flex-start}
  /* party minis rail (step 4) */
  .bb-bb-minis{margin:34px auto 0;max-width:1200px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 20px 18px;box-shadow:0 8px 30px rgba(43,47,61,.06)}
  .bb-bb-minis[hidden]{display:none}
  .bb-bb-minis .bb-bb-steplbl{margin-bottom:16px}
  .bb-bb-minis__row{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px;-webkit-overflow-scrolling:touch}
  .bb-bb-mini{flex:0 0 150px;display:flex;flex-direction:column;gap:6px;font-family:var(--baseFont,system-ui,sans-serif);text-align:center;background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px;transition:border-color .15s}
  .bb-bb-mini img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px;background:var(--cream-deep);display:block}
  .bb-bb-mini__t{font-size:11px;line-height:1.3;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:29px}
  .bb-bb-mini__p{font-size:11.5px;font-weight:700;color:var(--rose-deep)}
  .bb-bb-mini__p small{font-weight:600;color:var(--muted);font-size:10px}
  .bb-bb-mini__step{display:flex;align-items:center;justify-content:center;gap:10px}
  .bb-bb-mini__step button{width:28px;height:28px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--ink);font-size:15px;font-weight:800;line-height:1;cursor:pointer;transition:border-color .15s}
  .bb-bb-mini__step button:hover{border-color:var(--rose)}
  .bb-bb-mini__q{font-size:13px;font-weight:800;color:var(--ink);min-width:16px;font-variant-numeric:tabular-nums}
  .bb-bb-mini.has-qty{border-color:var(--rose);box-shadow:0 0 0 1px var(--rose)}
  .bb-bb-minis__sum{font-family:var(--baseFont,system-ui,sans-serif);font-size:12.5px;font-weight:700;color:var(--ink);text-align:center;margin:12px 0 0}
  .bb-bb-minis__sum[hidden]{display:none}
  .bb-bb-faves[hidden]{display:none}
  /* scroll rails: arrow affordance for horizontal rows */
  .bb-bb-rail{position:relative}
  .bb-bb-rail__arr{position:absolute;top:50%;transform:translateY(-50%);z-index:6;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--ink);font-size:20px;font-weight:700;line-height:1;cursor:pointer;box-shadow:0 2px 12px rgba(43,47,61,.18);display:flex;align-items:center;justify-content:center;padding:0 0 2px;transition:border-color .15s}
  .bb-bb-rail__arr:hover{border-color:var(--rose)}
  .bb-bb-rail__arr--l{left:-4px}
  .bb-bb-rail__arr--r{right:-4px}
  @media (max-width:800px){.bb-bb-rail__arr{width:30px;height:30px;font-size:18px}}
  /* pre-built gift sets */
  .bb-bb-sets{margin:0}
  .bb-bb-sets__lbl{display:flex;align-items:center;gap:14px;max-width:560px;margin:16px auto 12px;font-family:var(--baseFont,system-ui,sans-serif);font-size:10.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .bb-bb-sets__lbl i{flex:1;border-top:1px solid var(--line)}
  .bb-bb-sets__lbl span{white-space:nowrap}
  .bb-bb-sets__row{display:flex;gap:11px;justify-content:flex-start;flex-wrap:nowrap;overflow-x:auto;padding:15px 2px 10px;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch}
  @media (min-width:1101px){.bb-bb-sets__row{justify-content:center}}
  .bb-bb-set{position:relative;display:flex;flex-direction:column;align-items:center;gap:5px;flex:0 0 150px;width:150px;scroll-snap-align:start;font-family:var(--baseFont,system-ui,sans-serif);text-align:center;background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px 12px 12px;cursor:pointer;transition:all .2s;box-shadow:0 1px 6px rgba(43,47,61,.04)}
  .bb-bb-set:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(43,47,61,.12);border-color:var(--rose)}
  .bb-bb-set.is-active{border-color:var(--rose);box-shadow:0 0 0 2px var(--rose)}
  .bb-bb-set__badge{position:absolute;top:-10px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--rose);color:var(--ink);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:999px}
  .bb-bb-set__thumbs{display:flex;gap:4px}
  .bb-bb-set__thumbs span,.bb-bb-set__thumbs img{width:38px;height:38px;border-radius:8px;border:1px solid var(--line);background-color:var(--cream-deep);background-size:cover;background-position:center;object-fit:cover;display:block}
