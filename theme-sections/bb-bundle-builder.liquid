        else{var pctV=Math.round((paintedC-pp)/paintedC*100);valLine.innerHTML=tw+' hand-painted bottle'+(tw!==1?'s':'')+' would run ~'+money0(paintedC)+' — you’re at <b>'+money(pp)+'</b>'+(freeActive()>0?(' + '+freeActive()+' free'):'')+' ('+pctV+'% less).';}
