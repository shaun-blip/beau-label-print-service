  function showFlipbar(msg,onGo){flipbar.innerHTML='<span>'+msg+'</span>';var go=document.createElement('button');go.className='is-go';go.textContent='Switch';var no=document.createElement('button');no.textContent='Keep as-is';go.addEventListener('click',function(){hideFlipbar();onGo();});no.addEventListener('click',hideFlipbar);flipbar.appendChild(go);flipbar.appendChild(no);flipbar.hidden=false;}
  function flashSilentBottle(){if(currentBottle==='Prosecco'||currentBottle==='Champagne')flipAll(currentBottle,{silent:true});}
  function flipAll(target,opts){
    opts=opts||{};
    var items=paid.concat(free),elig=[],inelig=0;
    items.forEach(function(s){if(!s||s.bottleType===target)return;if(siblingForBottle(s.handle,target))elig.push(s);else inelig++;});
    function doFlip(){
      currentBottle=target;setBottleUI(target);renderGrid();
      if(!elig.length){render();return;}
      elig.forEach(function(s){s._busy=true;});render();
      Promise.all(elig.map(function(s){var sib=siblingForBottle(s.handle,target);return resolve(sib).then(function(r){applyResolved(s,sib,target,r);});})).then(function(){hideFlipbar();render();}).catch(function(){render();});
    }
    if(!opts.silent&&inelig&&elig.length){showFlipbar(elig.length+' of '+(elig.length+inelig)+' wraps switch to '+target+'. '+inelig+' only come in their current bottle and stay as-is.',doFlip);}
    else if(!opts.silent&&inelig&&!elig.length){currentBottle=target;setBottleUI(target);flash('These designs come in one bottle only. New picks will be '+target+'.');render();}
    else{doFlip();}
  }

  // prefill
  function prefill(){paid=[];free=[];fillPaid();fillFree();flashSilentBottle();render();}
  function seedPrefill(handles){
    paid=[];free=[];render();
    Promise.all(handles.slice(0,MAXPAID).map(function(h){return resolve(h).then(function(r){return {handle:h,bottleType:bottleOf(h),variantId:r.variantId,title:r.title,img:r.image,price:r.price,available:r.available,_busy:false};}).catch(function(){return null;});})).then(function(arr){
      if(paid.length||free.length)return;   // shopper already picking — don't clobber
      // slots take SINGLE wraps only (function band $4–8, in stock). Seeded minis/sets are
      // NOT slotted — they already count toward free wraps from the cart, so tell her that
      // instead of silently stranding them (the old minis dead-end).
      var ok=arr.filter(function(x){return x&&x.available!==false&&x.price>=400&&x.price<=800;});
      var dropped=arr.filter(Boolean).length-ok.length;
      paid=ok;stageSeeding=false;flashSilentBottle();render();   // place ONLY the seeded wraps (e.g. from cart); no auto top-up
      if(dropped>0)flash('Your minis stay in your cart and count toward free wraps automatically — no need to re-add them here.');
      else if(handles.length>MAXPAID)flash('Our biggest bundle is '+MAXPAID+' wraps — we added the first '+MAXPAID+'.');
    });
  }

  // Returning with a bundle already in the cart: resume it in place (size, bottle,
  // paid + free picks) so a 5-to-10 upgrade starts from the 5 already chosen.
  // checkout() then replaces the old _bb lines - sizing up never doubles the cart.
  // eligible loose wrap lines in the cart: counted toward the tiers + shown read-only in the tray.
  // ONLY product type "Bottle Wrap" counts — bows, EverVase, napkins etc. are never touched or counted.
  var cartHandles={};
  function readCartView(c){
    cartLooseCents=0;cartItemsView=[];cartHandles={};
    (c.items||[]).forEach(function(i){
      if((i.product_type||'')!=='Bottle Wrap')return;
      if(/tester|practice|perfect-your-technique/i.test(i.handle||''))return;
      if(i.properties&&i.properties._bb)return;
      var lp=(typeof i.final_line_price==='number'?i.final_line_price:i.line_price)||0;
      if(i.quantity>0&&Math.round(lp/i.quantity)<400)return;   // sub-$4/unit (testers) never count toward the ladder
      cartLooseCents+=lp;cartHandles[i.handle]=1;
      cartItemsView.push({key:i.key,title:cleanTitle(i.product_title||i.title||'').replace(/[<>&"]/g,''),img:i.image||'',price:lp,qty:i.quantity||1});
    });
  }
  function refreshCartView(){fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(c){readCartView(c);render();}).catch(function(){});}
  // the cart can change outside the builder (drawer qty edits, other tabs) — stay in sync:
  // piggyback on any cart API call made from this page, and re-check on tab return.
  (function(){
    if(window.__bbCartHook)return;window.__bbCartHook=1;
    var of=window.fetch;
    window.fetch=function(){var a=arguments,p=of.apply(this,a);
      try{var u=String((a[0]&&a[0].url)||a[0]||'');if(/\/cart\/(add|change|update|clear)/.test(u))p.then(function(){setTimeout(refreshCartView,200);},function(){});}catch(e){}
      return p;};
    window.addEventListener('pageshow',function(){refreshCartView();});
    document.addEventListener('visibilitychange',function(){if(!document.hidden)refreshCartView();});
  })();
  function cartResume(extra){
    extra=extra||[];   // ?seed handles + wraps staged via "Add to bundle" (bundle bridge)
    fetch('/cart.js').then(function(r){return r.json();}).then(function(c){
      // ladder-eligible wrap spend already in the cart (loose lines, not builder-managed _bb):
      // feeds freeCount() so cart wraps + minis raise the free tier, and powers claim mode.
      readCartView(c);
      // DOUBLE-COUNT GUARD: a wrap that's both in the cart AND staged/seeded (bbStage,
      // ?seed=) must not become a paid pick too — its spend is already counted from the
      // cart line. (Verified live: the overlap inflated spend and falsely met tiers.)
      extra=(extra||[]).filter(function(h){return !cartHandles[h];});
      var lines=(c.items||[]).filter(function(i){return i.properties&&i.properties._bb;});
      if(claimMode&&cartLooseCents<T1)claimMode=false;   // nothing claimable — behave as a normal visit (keeps staged seeds)
      if(claimMode&&!urlSized&&!userSized&&cartLooseCents>=T1){var ct=cartLooseCents>=T3?15:cartLooseCents>=T2?10:5;paidTarget=ct;syncSizeBtns();updateSizeUI();}   // claim arrival: goal = the tier the cart actually reached (never below-tier)
      if(!lines.length){if(extra.length&&!claimMode){seedPrefill(extra);}else{stageSeeding=false;render();}if(claimMode&&freeCount()>0)flash('Your cart already earned '+freeCount()+' FREE wrap'+(freeCount()!==1?'s':'')+' — tap wraps below to claim, then add to cart.');return;}
      claimMode=false;   // a builder bundle is already in the cart — resume it (its flow includes free slots)
      var sz=0,bt='';
      lines.forEach(function(i){var p=i.properties;if(p._bbsz)sz=parseInt(p._bbsz,10)||sz;if(p._bbb)bt=p._bbb;});
      if((bt==='Prosecco'||bt==='Champagne'||bt==='Wine')&&bt!==currentBottle){currentBottle=bt;setBottleUI(bt);renderGrid();}
      if(!urlSized&&sz>=5){paidTarget=sz;userSized=true;syncSizeBtns();updateSizeUI();}
      var ph=[],fh=[];
      lines.forEach(function(i){var t=i.properties._bbfree?fh:ph;for(var q=0;q<i.quantity;q++)t.push(i.handle);});
      extra.forEach(function(h){ph.push(h);});   // staged wraps join the resumed bundle as paid picks
      var pn=Math.min(ph.length,MAXPAID);
      Promise.all(ph.slice(0,pn).concat(fh.slice(0,20)).map(function(h){
        return resolve(h).then(function(r){return {handle:h,bottleType:bottleOf(h),variantId:r.variantId,title:r.title,img:r.image,price:r.price,available:r.available,_busy:false};}).catch(function(){return null;});
      })).then(function(arr){
        if(paid.length||free.length)return;   // shopper started picking while we resumed — their picks win
        var band=function(x){return x&&x.available!==false&&x.price>=400&&x.price<=800;};   // singles only, in stock — keep slots == what the function counts
        paid=arr.slice(0,pn).filter(band);
        free=arr.slice(pn).filter(function(x){return band(x)&&freeOK(x.bottleType,x.handle);});
        var droppedN=arr.filter(Boolean).length-paid.length-free.length;
        if(droppedN>0)flash(droppedN+' wrap'+(droppedN!==1?'s':'')+' from your saved bundle '+(droppedN!==1?'are':'is')+' no longer available and was left out.');
        stageSeeding=false;
        render();
      });
    }).catch(function(){stageSeeding=false;render();});
  }

