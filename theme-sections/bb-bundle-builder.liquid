  var SEASONAL_TAGS=['occasion-christmas','occasion-halloween','occasion-valentines','occasion-hanukkah','occasion-easter','occasion-thanksgiving','occasion-new-years'];
  // specific beats generic: occasion/recipient tags say WHY she's buying; style tags are everywhere and would drown them
  var TAG_W={occasion:4,'for':2.5,motif:1.5,style:0.75};
  // sparse clusters need help: seeing one of these tags in the bundle also credits its neighbors at half weight
  var RELATED={
    'occasion-gameday':['for-football','for-college-sports','motif-sports-equipment','for-golf','for-tennis','for-pickleball','for-fishing'],
    'for-football':['occasion-gameday','for-college-sports','motif-sports-equipment'],
    'for-college-sports':['occasion-gameday','for-football','motif-sports-equipment'],
    'motif-sports-equipment':['occasion-gameday','for-golf','for-tennis','for-pickleball','for-football'],
    'occasion-wedding':['for-bridal','occasion-engagement','occasion-bridal-shower','occasion-bachelorette','motif-wedding'],
    'for-bridal':['occasion-wedding','occasion-engagement','occasion-bridal-shower'],
    'occasion-engagement':['occasion-wedding','for-bridal'],
    'occasion-birthday':['motif-balloons','motif-cakes-sweets','motif-party-hats'],
    'for-hostess':['occasion-hostess','for-entertaining-hostess','for-wine-bubbly','occasion-cocktail-party'],
    'occasion-hostess':['for-hostess','for-entertaining-hostess','for-wine-bubbly']
  };
  function bundleTagCounts(){
    var counts={};
    paid.concat(free).forEach(function(s){if(!s||!s.handle)return;(poolTagMap[s.handle]||[]).forEach(function(t){var g=t.split('-')[0];if(g==='occasion'||g==='style'||g==='motif'||g==='for')counts[t]=(counts[t]||0)+1;});});
    var expanded={};
    for(var t in counts){expanded[t]=(expanded[t]||0)+counts[t];(RELATED[t]||[]).forEach(function(r){expanded[r]=(expanded[r]||0)+counts[t]*0.5;});}
    return expanded;
  }
  function affinity(tags,counts){
    var sc=0;
    tags.forEach(function(t){if(counts[t])sc+=(TAG_W[t.split('-')[0]]||1)*Math.min(counts[t],3);});  // cap per-tag influence
    SEASONAL_TAGS.forEach(function(st){if(tags.indexOf(st)>-1&&!counts[st])sc-=2;});   // off-season sinks unless the bundle is that season
    return sc;
  }
  // design "family" key: title minus colorways — so a smart fill never stacks near-identical designs
  var COLORWORDS=/\b(blue|red|pink|green|navy|orange|purple|yellow|black|white|crimson|grey|gray|gold|silver|royal|pastel|sage|beige|tan|lavender|blush|teal|aqua|coral|mint|ivory|cream|burgundy|maroon|light|dark)\b/g;
  function familyKey(t){return cleanTitle(t||'').toLowerCase().replace(COLORWORDS,'').replace(/[^a-z ]/g,' ').replace(/\s+/g,' ').trim();}
  // rank minis by affinity with what's actually in the bundle (works for presets AND hand-built)
  function rankMinis(){
    var counts=bundleTagCounts();
    minisView=minis.map(function(m,i){return {m:m,sc:affinity(m.tags,counts),i:i};})
      .sort(function(a,b){return b.sc-a.sc||a.i-b.i;}).map(function(x){return x.m;});
  }
  // smart wrap candidates for "fill the rest": affinity-ranked, best-seller boosted, max 2 per design family
  function smartCandidates(){
    var counts=bundleTagCounts(),have=picked(),famCount={},exact={};
    paid.concat(free).forEach(function(s){if(s&&s.title){famCount[familyKey(s.title)]=(famCount[familyKey(s.title)]||0)+1;exact[cleanTitle(s.title).toLowerCase()]=1;}});
    var scored=pool.filter(function(p){return p._bottle===currentBottle&&!have[p.handle];})
      .map(function(p,i){var sc=affinity(p._tags,counts);if(bestMatch(p))sc+=0.5;return {p:p,sc:sc,i:i};})
      .sort(function(a,b){return b.sc-a.sc||a.i-b.i;});
    var out=[];
    scored.forEach(function(x){
      var ek=cleanTitle(x.p.title).toLowerCase();if(exact[ek])return;        // never a second copy of the same design (catalog has dupes)
      var k=familyKey(x.p.title);if((famCount[k]||0)>=2)return;              // max 2 per colorway family
      exact[ek]=1;famCount[k]=(famCount[k]||0)+1;out.push(x.p);
    });
    return out;
  }
  function fillSmart(){
    var cands=smartCandidates(),i=0;
    while(spendAll()<goalCents()&&paid.length<MAXPAID&&i<cands.length){paid.push(toSlot(cands[i++]));}
    var fc=freeCount();while(free.length<fc&&i<cands.length){var fs=toSlot(cands[i++]);if(freeOK(fs.bottleType,fs.handle))free.push(fs);}
  }
  function packOf(t){t=(t||'').toLowerCase();if(/six|6[- ]?pack/.test(t))return 6;if(/three|3[- ]?pack|set of 3/.test(t))return 3;return 1;}
  function minisTotal(){var s=0;minis.forEach(function(m){s+=(minisQty[m.handle]||0)*m.price;});return s;}
  function minisSelList(){return minis.filter(function(m){return (minisQty[m.handle]||0)>0;}).map(function(m){return {variantId:m.variantId,qty:minisQty[m.handle]};});}
  function minisReset(){minisQty={};renderMinis();}
  function cleanMiniTitle(t){return (t||'').replace(/mini prosecco (collection|wraps?)/ig,'').replace(/set of \d+ wraps? only/ig,'').replace(/\(\s*\d+[- ]?pack\s*\)/ig,'').replace(/beau bottles/ig,'').replace(/[–—-]\s*/g,' ').replace(/\s{2,}/g,' ').trim();}
  function loadMinis(){
    function pg(page,acc){return fetch('/collections/'+MINIS_COL+'/products.json?limit=250&page='+page).then(function(r){return r.json();}).then(function(j){var ps=(j&&j.products)||[];acc=acc.concat(ps);return (ps.length===250&&page<5)?pg(page+1,acc):acc;}).catch(function(){return acc;});}
    pg(1,[]).then(function(all){
      minis=all.filter(function(p){var v=p.variants&&p.variants[0];return v&&v.available&&/mini/.test(p.handle)&&(p.product_type||'')==='Bottle Wrap'&&toCents(v.price)>0;}).map(function(p){var v=p.variants[0];return {handle:p.handle,variantId:v.id,price:toCents(v.price),title:p.title,img:(p.images&&p.images[0]?p.images[0].src:''),pack:packOf(p.title+' '+p.handle),tags:(p.tags||[]).map(function(t){return (''+t).toLowerCase();})};});
      minisView=minis.slice();
      rankMinis();renderGrid();   // minis render inside the main grid now (no rail)
    });
  }
  function renderMinis(){
    if(!minisRow)return;
    var list=(minisView.length?minisView:minis).slice(0,14);
    minisRow.innerHTML=list.map(function(m,i){
      var q=minisQty[m.handle]||0;
      var per=m.pack>1?' <small>· '+m.pack+'-pack · '+money(Math.round(m.price/m.pack))+'/mini</small>':'';
      return '<div class="bb-bb-mini'+(q>0?' has-qty':'')+'"><img src="'+withW(m.img,300)+'" loading="lazy" alt=""><span class="bb-bb-mini__t">'+cleanMiniTitle(m.title)+'</span><span class="bb-bb-mini__p">'+money(m.price)+per+'</span><span class="bb-bb-mini__step"><button type="button" data-mini-minus="'+i+'" aria-label="Remove one pack">−</button><span class="bb-bb-mini__q">'+q+'</span><button type="button" data-mini-plus="'+i+'" aria-label="Add one pack">+</button></span></div>';
    }).join('');
    minisRow.querySelectorAll('[data-mini-plus]').forEach(function(b){b.addEventListener('click',function(){var m=list[parseInt(b.dataset.miniPlus,10)];minisQty[m.handle]=Math.min(8,(minisQty[m.handle]||0)+1);if(!minisTracked){minisTracked=true;try{(window.dataLayer=window.dataLayer||[]).push({event:'bb_minis_attach'});}catch(e){}}renderMinis();render();});});
    minisRow.querySelectorAll('[data-mini-minus]').forEach(function(b){b.addEventListener('click',function(){var m=list[parseInt(b.dataset.miniMinus,10)];minisQty[m.handle]=Math.max(0,(minisQty[m.handle]||0)-1);renderMinis();render();});});
    if(minisRow._railUpd)minisRow._railUpd();
    updateMinisSum();
  }
  function updateMinisSum(){
    if(!minisSumEl)return;var t=minisTotal(),n=0;
    minis.forEach(function(m){n+=(minisQty[m.handle]||0)*m.pack;});
    if(t>0){minisSumEl.hidden=false;minisSumEl.textContent='Party favors: '+n+' minis · '+money(t)+' — counts toward your free-wrap total, added with your bundle at checkout';}
    else{minisSumEl.hidden=true;}
  }
  function updateMinisUI(bundleFull){
    // Re-rank minis to the bundle's theme as picks change — but NEVER rebuild the grid
    // unless the Mini tab is showing (a full grid rebuild on every pick collapses the
    // page height mid-reflow and dumps the scroll position — Shaun's "jumps to top").
    if(!minis.length||minisTotal()>0)return;
    var sig=paid.map(function(s){return s?s.handle:'';}).join(',');
    if(sig!==minisSig){minisSig=sig;rankMinis();if(currentBottle==='Mini')renderGrid();}
  }

  // URL-seeded entry: ?size=10&collection=wedding&q=floral&bottle=Champagne&seed=h1,h2&preset=the-hostess-set
  (function initSeed(){
    var sp;try{sp=new URLSearchParams(location.search);}catch(e){return;}
    if(sp.get('claim')==='1')claimMode=true;   // cart banners: "pick your free wraps" — no pack required
    var ps=parseInt(sp.get('size'),10);if([5,10,15].indexOf(ps)>-1){urlSized=true;claimMode=false;paidTarget=ps;root.querySelectorAll('.bb-bb-size').forEach(function(x){x.classList.toggle('is-active',parseInt(x.dataset.size,10)===paidTarget);});}
    var pb=sp.get('bottle');if(pb==='Prosecco'||pb==='Champagne'){currentBottle=pb;setBottleUI(pb);}
    var pq=sp.get('q');if(pq){query=pq;qtokens=tokenize(pq);if(searchEl)searchEl.value=pq;if(clearEl)clearEl.hidden=false;}
    var psd=sp.get('seed');seedHandles=psd?psd.split(',').map(function(x){return x.trim();}).filter(Boolean):[];
    var ppr=sp.get('preset');if(ppr)presetPending=ppr.trim().toLowerCase();
    // Bundle-bridge ingest: wraps staged site-wide via "Add to bundle" (localStorage bbStage,
    // written by bb-bundle-core) join the builder as paid picks. URL ?seed handles come first;
    // a staged qty>1 becomes that many copies. Stage is re-synced from the bundle in save().
    try{
      var stg=JSON.parse(localStorage.getItem('bbStage')||'[]');
      (stg||[]).forEach(function(x){
        if(!x||!x.handle)return;
        var q=Math.max(1,parseInt(x.qty,10)||1),start=seedHandles.indexOf(x.handle)>-1?1:0;
        for(var i=start;i<q&&seedHandles.length<MAXPAID;i++)seedHandles.push(x.handle);
      });
    }catch(e){}
    // PDP tier picker wrote a pack size (bbStageSize) — open at that size (URL ?size= wins)
    if(!urlSized){var ss=parseInt(localStorage.getItem('bbStageSize')||'',10);if([5,10,15].indexOf(ss)>-1&&ss!==paidTarget){userSized=true;paidTarget=ss;syncSizeBtns();}}
  })();

  updateSizeUI();
  loadPool();
  loadMinis();
})();
</script>

