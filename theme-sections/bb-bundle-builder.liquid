  /* tray */
  .bb-bb-tray{position:sticky;top:90px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px 24px;box-shadow:0 8px 30px rgba(43,47,61,.07);overflow-y:auto;overflow-x:hidden;max-height:calc(100vh - 106px);overscroll-behavior:contain}
