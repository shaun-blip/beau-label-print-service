  .bb-tl__x:hover{background:#3A4A7A}
  .bb-tl__sw{color:var(--ink)}
  .bb-tl__sw--btn{border:1px solid var(--ink);border-radius:0;color:var(--ink);background:transparent}
  .bb-tl__sw--btn:hover{background:#FAE6EC;color:var(--ink)}
  .bb-tl__ft{color:var(--muted)}
  .bb-tl--cart .bb-tl__imgw{border-style:solid;border-color:#C5DDF0}
  .bb-tl__carttag{background:var(--ink);color:#FFFDF8;border-radius:0}
  .bb-it-sec__t{color:var(--ink);letter-spacing:.2em}
  .bb-it-sec__s{color:var(--muted)}
  .bb-bb-spend__bar{background:#E6E1D6;border-radius:0}
  .bb-bb-spend__bar i{background:var(--ink);border-radius:0}
  .bb-bb-spend__txt{color:var(--ink)}
  .bb-bb-spend__txt b{color:var(--ink);font-weight:600}
  .bb-bb-valueline{color:var(--muted)}
  .bb-bb-valueline b{color:var(--ink);font-weight:600}
  .bb-bb-ship__txt{color:var(--muted)}
  .bb-bb-ship__done{color:var(--ink);font-weight:600}
  .bb-bb-ship__bar{background:#E6E1D6}
  .bb-bb-ship__bar i{background:var(--ink)}
  .bb-bb-fillrest{background:transparent;border:1px solid var(--ink);color:var(--ink);border-radius:0;font-family:var(--baseFont);letter-spacing:.08em;text-transform:uppercase;font-size:12px;font-weight:500}
  .bb-bb-fillrest:hover{background:#FAE6EC}
  .bb-bb-more{background:transparent;border:1px dashed var(--ink);color:var(--ink);border-radius:0}
  .bb-bb-nudge{color:var(--ink)}
  .bb-bb-guard{background:#fff;border:2px solid var(--ink);border-radius:0;color:var(--ink)}
  .bb-bb-guard__go{background:var(--ink);color:#FFFDF8;border:none;border-radius:0;font-family:var(--baseFont);letter-spacing:.12em;text-transform:uppercase;font-size:12px;font-weight:500;padding:12px 18px;cursor:pointer}
  .bb-bb-guard__skip{background:none;border:none;color:var(--ink);text-decoration:underline;text-underline-offset:3px;font-family:var(--baseFont);font-size:12.5px;cursor:pointer;padding:12px 8px}
  .bb-bb-note{color:var(--ink)}
  .bb-bb-atctrust{color:var(--muted)}
  .bb-bb-add{display:block;width:100%;background:var(--ink);color:#FFFDF8;border:none;border-radius:0;font-family:var(--baseFont);letter-spacing:.2em;text-transform:uppercase;font-size:13px;font-weight:500;padding:17px 16px;cursor:pointer}
  .bb-bb-add:hover{background:#3A4A7A}
  .bb-bb-add:disabled{opacity:.45;cursor:default}
  .bb-bb-atcdock{box-shadow:0 -10px 16px -10px rgba(27,36,64,.15)}
  .bb-bb-added{background:#EEF2FA;border:1px solid #C5DDF0;border-radius:0;color:var(--ink)}
  .bb-bb-added a{color:var(--ink)}
  .bb-bb-savenote{color:var(--ink)}
  .bb-bb-savenote b{color:var(--ink);font-weight:600}
  .bb-bb-tray.bb-shine::before{content:"";position:absolute;inset:0;z-index:5;pointer-events:none;background:linear-gradient(115deg,transparent 30%,rgba(243,207,218,.45) 48%,rgba(197,221,240,.35) 52%,transparent 70%);transform:translateX(-110%);animation:bbShine .95s ease forwards}
  @keyframes bbShine{to{transform:translateX(110%)}}
  @media (prefers-reduced-motion: reduce){.bb-bb-tray.bb-shine::before{animation:none;display:none}}
  /* mobile bar + sheets: cream, square, navy CTAs */
  .bb-bb-flipbar{background:#FFFDF8;border:1px solid var(--ink);border-radius:0;color:var(--ink)}
  .bb-bb-flipbar button{border-radius:0;font-family:var(--baseFont)}
  .bb-bb-zoom__switch,.bb-bb-zoom__remove{border-radius:0}
  @media (max-width:800px){
    .bb-bb-stickybar{background:rgba(255,253,248,.94);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:1px solid var(--line)}
    .bb-bb-stickybar__count{font-family:var(--titleFont);font-weight:400;font-size:21px;color:var(--ink)}
    .bb-bb-stickybar__sub{font-family:var(--baseFont);color:var(--ink);font-weight:500;letter-spacing:.04em}
    .bb-bb-stickybar__chev{color:var(--muted);letter-spacing:.14em}
    .bb-bb-stickybar__find{background:var(--ink);border:1px solid var(--ink);color:#FFFDF8;border-radius:0;font-family:var(--baseFont);letter-spacing:.1em;text-transform:uppercase;font-size:12.5px;font-weight:500}
    .bb-bb-stickybar.has-cta .bb-bb-stickybar__find{background:#fff;color:var(--ink);border:1px solid var(--ink)}
    .bb-bb-stickybar__btn{background:#F3CFDA;color:var(--ink);border-radius:0;font-family:var(--baseFont);letter-spacing:.06em;text-transform:uppercase;font-size:13px;font-weight:600}
    .bb-bb-stickybar__btn.is-ready{background:var(--ink);color:#FFFDF8}
    .bb-bb-tray{border-radius:0;border-left:none;border-right:none;border-bottom:none}
    .bb-bb-sheet__panel{border-radius:0}
    .bb-bb-sheet__done{color:var(--ink);letter-spacing:.14em;text-transform:uppercase;font-weight:600}
    .bb-bb-sheet__in{border-radius:0;border:1px solid var(--ink)}
    .bb-bb-sheet__title{font-family:var(--titleFont);font-style:italic;font-weight:400;font-size:18px}
    .bb-bb-findbar{border:1px solid var(--ink)}
    .bb-bb-grid{grid-template-columns:repeat(2,1fr);gap:16px 12px}
  }
</style>

{% schema %}
{
  "name": "Build-a-Bundle",
  "tag": "section",
  "settings": [
    { "type": "url", "id": "shop_url", "label": "Continue-shopping fallback URL", "info": "Where 'Continue shopping' goes if the previous page can't be detected. Default: /collections/all." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build a Bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Bundle" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick your wraps, switch the bottle, and unlock free ones as you spend — a fraction of the cost of hand-painted bottles." },
    { "type": "select", "id": "default_bottle", "label": "Default bottle", "options": [ {"value":"Prosecco","label":"Prosecco"}, {"value":"Champagne","label":"Champagne"} ], "default": "Prosecco", "info": "Prosecco has the widest design coverage." },
    { "type": "select", "id": "default_size", "label": "Default size", "options": [ {"value":"5","label":"5-pack"}, {"value":"10","label":"10-pack"}, {"value":"15","label":"15-pack"} ], "default": "10" },
    { "type": "collection", "id": "source_collection", "label": "Prosecco wraps collection (pool)", "info": "Default: la-marca-wraps. Single wraps only — minis/multipacks are auto-excluded." },
    { "type": "collection", "id": "champagne_collection", "label": "Champagne wraps collection (pool)", "info": "Default: champagne-collection." },
    { "type": "checkbox", "id": "enable_wine", "label": "Enable Wine bottle", "default": true, "info": "Adds a third 'Wine' toggle (e.g. the DAOU wine line)." },
    { "type": "collection", "id": "wine_collection", "label": "Wine wraps collection (pool)", "info": "Default: wine-collection." },
    { "type": "range", "id": "grid_cap", "label": "Max wraps shown at once", "min": 8, "max": 40, "step": 4, "default": 16 },
    { "type": "range", "id": "painted_bottle_value", "label": "Hand-painted bottle value per wrap ($)", "min": 50, "max": 500, "step": 10, "default": 250, "unit": "$" },
    { "type": "range", "id": "free_ship_threshold", "label": "Free-shipping threshold ($)", "min": 0, "max": 150, "step": 5, "default": 40, "unit": "$", "info": "Set to 0 to hide the free-shipping bar." },
    { "type": "header", "content": "Free wraps per spend tier" },
    { "type": "paragraph", "content": "Tiers are clean $39/$79/$119 thresholds and MUST match the deployed Free Wraps function." },
    { "type": "range", "id": "free_5", "label": "Tier 1 free wraps", "min": 0, "max": 8, "step": 1, "default": 2 },
    { "type": "range", "id": "free_10", "label": "Tier 2 free wraps", "min": 0, "max": 12, "step": 1, "default": 5 },
    { "type": "range", "id": "free_15", "label": "Tier 3 free wraps", "min": 0, "max": 16, "step": 1, "default": 10 },
    { "type": "header", "content": "Add more wraps (beyond Tier 3)" },
    { "type": "range", "id": "max_paid", "label": "Max paid wraps", "min": 15, "max": 60, "step": 1, "default": 30 },
    { "type": "range", "id": "free_extra_per5", "label": "Extra free wraps per +5 beyond 15", "min": 0, "max": 4, "step": 1, "default": 2 },
    { "type": "header", "content": "Trust signals" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust signals", "default": true },
    { "type": "text", "id": "trust_rating", "label": "Average rating", "default": "4.7", "info": "Your real Judge.me average — keep it accurate. A flat 5.0 reads as fake." },
    { "type": "text", "id": "trust_reviews", "label": "Review count", "default": "200" },
    { "type": "text", "id": "trust_customers", "label": "Customer count", "default": "120,000" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee label", "default": "30-Day Money-Back Guarantee" },
    { "type": "header", "content": "Party minis (step 4)" },
    { "type": "collection", "id": "minis_collection", "label": "Minis collection", "info": "Mini packs offered as add-on party favors. Default: mini-la-marca. They join the cart as normal lines and their price COUNTS toward the spend-based free-wrap tiers (testers never do)." },
    { "type": "header", "content": "Mini bundle (separate builder)" },
    { "type": "checkbox", "id": "enable_mini", "label": "Show \"Wrapping minis?\" link", "default": false, "info": "Keep OFF until the separate Mini bundle builder + its own Simple Bundles config exist. Minis are multi-packs with different economics and are excluded from in-slot switching." },
    { "type": "url", "id": "mini_url", "label": "Mini bundle page URL" }
  ],
  "presets": [ { "name": "Build-a-Bundle" } ],
  "enabled_on": { "templates": ["page","index"] }
}
{% endschema %}
