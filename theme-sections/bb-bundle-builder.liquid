  .bb-bb-slot__spin{position:absolute;inset:0;background:rgba(255,255,255,.6);display:flex;align-items:center;justify-content:center;z-index:4}
  .bb-bb-slot__spin::after{content:"";width:18px;height:18px;border:2px solid var(--rose);border-top-color:transparent;border-radius:50%;animation:bbspin .7s linear infinite}
