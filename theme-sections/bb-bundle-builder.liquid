  .bb-bb-card.is-added .bb-bb-card__imgw{border-color:var(--ink);box-shadow:0 0 0 1.5px var(--ink)}
  .bb-bb-card.is-added .bb-bb-card__chk{color:#FFFDF8;background:var(--ink);border-color:var(--ink)}
  .bb-bb-slot__free{background:var(--ink);border-radius:0}
  .bb-bb-step::before,.bb-bb-steplbl--fill::before{content:none}
