      fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:b.dataset.cartX,quantity:0})})
        .then(function(){refreshCartView();}).catch(function(){b.disabled=false;flash('Couldn’t remove that — try again.');});
    });});
    slotsEl.querySelectorAll('[data-bt-arr]').forEach(function(btn){btn.addEventListener('click',function(e){e.stopPropagation();flipSlot(btn.dataset.btArr,parseInt(btn.dataset.btIdx,10),btn.dataset.bt);});});
    slotsEl.querySelectorAll('[data-zoom-arr]').forEach(function(el){el.addEventListener('click',function(e){
      if(e.target&&e.target.closest&&e.target.closest('.bb-tl__x'))return;
      var arrK=el.dataset.zoomArr,idxN=parseInt(el.dataset.zoomIdx,10);
      var st=(arrK==='f'?free:paid)[idxN];
