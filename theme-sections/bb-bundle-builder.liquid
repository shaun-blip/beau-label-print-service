    toastEl=document.createElement('div');toastEl.className='bb-bb-toast';toastEl.setAttribute('role','status');toastEl.setAttribute('aria-live','polite');document.body.appendChild(toastEl);
    var barProg=document.createElement('div');barProg.className='bb-bb-barprog';barProg.innerHTML='<i></i>';stickybarEl.insertBefore(barProg,stickybarEl.firstChild);
  }
