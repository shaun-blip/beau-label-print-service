  .bb-bb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(178px,1fr));gap:16px;min-height:200px}
  .bb-bb-grid__loading{grid-column:1/-1;text-align:center;color:var(--muted);padding:48px 0;font-family:var(--baseFont,system-ui,sans-serif)}
  .bb-bb-help{font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;color:var(--muted);margin:14px 2px 0;line-height:1.45}
  .bb-bb-card{position:relative;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;cursor:pointer;transition:transform .2s,box-shadow .2s;text-align:left;padding:0;box-shadow:0 1px 6px rgba(43,47,61,.04)}
  .bb-bb-card__chk{position:absolute;top:6px;right:6px;z-index:2;display:flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 7px;border-radius:999px;font-family:var(--baseFont,system-ui,sans-serif);font-size:14px;font-weight:800;line-height:1;color:var(--ink);background:rgba(255,255,255,.96);border:1px solid var(--line);box-shadow:0 1px 5px rgba(43,47,61,.25)}
  .bb-bb-card__minus{position:absolute;top:6px;left:6px;z-index:3;display:none;align-items:center;justify-content:center;width:24px;height:24px;border-radius:999px;font-family:var(--baseFont,system-ui,sans-serif);font-size:17px;font-weight:800;line-height:1;color:#fff;background:rgba(43,47,61,.82);border:none;cursor:pointer;box-shadow:0 1px 5px rgba(43,47,61,.3)}
