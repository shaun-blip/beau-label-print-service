  .bb-bb-fillrest{width:100%;font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;font-weight:700;color:var(--ink);background:var(--rose-tint);border:1px solid var(--rose);border-radius:8px;padding:10px;cursor:pointer;margin-bottom:8px;transition:all .2s}
  .bb-bb-fillrest:hover{background:var(--rose-soft)}
  .bb-bb-fillrest[hidden]{display:none}
  .bb-bb-more{width:100%;font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;font-weight:600;color:var(--ink);background:#fff;border:1px dashed var(--line);border-radius:8px;padding:9px;cursor:pointer;margin-bottom:12px;transition:all .2s}
  .bb-bb-more:hover{border-color:var(--rose);color:var(--rose-deep)}
  .bb-bb-more:disabled{opacity:.5;cursor:default}
  .bb-bb-tray__count{font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;font-weight:600;letter-spacing:.04em;color:var(--muted);text-align:center;margin-bottom:12px}
  .bb-bb-tray__head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;min-height:30px}
  .bb-bb-tray__title{font-family:var(--baseFont,system-ui,sans-serif);font-size:15px;font-weight:700;letter-spacing:.01em;color:var(--ink)}
  .bb-bb-clearall{font-family:var(--baseFont,system-ui,sans-serif);font-size:11px;font-weight:700;color:var(--muted);background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 13px;cursor:pointer;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;transition:all .15s}
