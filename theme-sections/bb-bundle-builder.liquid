  .bb-bb-card__minitag{color:var(--ink);letter-spacing:.14em}
  .bb-bb-card__chk{border-radius:0;background:rgba(255,255,255,.96);color:var(--ink);border:1px solid var(--line)}
  .bb-bb-card__minus{border-radius:0;background:#fff;color:var(--ink);border:1px solid var(--ink)}
  /* selected = the standard's 2px navy ring + navy check (replaces the old green) */
