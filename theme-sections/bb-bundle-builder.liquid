  .bb-bb-card:hover{transform:translateY(-2px);border-color:var(--rose);box-shadow:0 6px 18px rgba(43,47,61,.10)}
  .bb-bb-card img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
  .bb-bb-card__t{font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;line-height:1.35;color:var(--ink);padding:9px 10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:43px}
  .bb-bb-card__pc{position:absolute;top:7px;left:7px;background:rgba(255,255,255,.94);backdrop-filter:blur(6px);color:var(--ink);font-size:9px;font-weight:700;letter-spacing:.04em;padding:3px 7px;border-radius:999px;box-shadow:0 1px 6px rgba(43,47,61,.12)}
