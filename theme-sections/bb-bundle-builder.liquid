<script>
(function(){
  var root=document.querySelector('.bb-bb');
  if(!root||root.dataset.bbBound==='1')return; root.dataset.bbBound='1';

  var PBV=parseFloat(root.dataset.pbv)||250;                 // painted-bottle $ per wrap
  var CAP=parseInt(root.dataset.gridCap,10)||16;
  var UNIT=795;                                              // single-wrap price (cents) — auto-detected for DISPLAY
  var T1=3900,T2=7900,T3=11900,TSTEP=3900;                   // tier thresholds — FIXED, must match the deployed Free Wraps function
  var SHIPC=3900;                                            // free-shipping trigger — a clean $39, matches the function
  var MAXPAID=parseInt(root.dataset.maxPaid,10)||30;
  var FREE_EXTRA=parseInt(root.dataset.freeExtra,10)||0;     // extra free per +5 beyond 15
  var SHIP=Math.round((parseFloat(root.dataset.ship)||0)*100); // free-ship threshold (cents)
  var freeMap={5:2,10:5,15:10};   // HARDCODED to the deployed Free Wraps function (2/5/10) — editing theme settings CANNOT change entitlements, so we don't pretend
  var WS=root.dataset.ws==='1';   // wholesale account: function refuses the offer, so the UI must not promise it
  if(WS){freeMap={5:0,10:0,15:0};FREE_EXTRA=0;}
  var grid=root.querySelector('[data-bb-grid]');
  var slotsEl=root.querySelector('[data-bb-slots]');
  var clearAllEl=root.querySelector('[data-bb-clearall]');
  var trayTitleEl=root.querySelector('[data-bb-tray-title]');
  var stickyCountEl=root.querySelector('[data-bb-sticky-count]');
  var stickySubEl=root.querySelector('[data-bb-sticky-sub]');
  var stickyCtaEl=root.querySelector('[data-bb-sticky-cta]');
  var stickybarEl=root.querySelector('[data-bb-stickybar]');
