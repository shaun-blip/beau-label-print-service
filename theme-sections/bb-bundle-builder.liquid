    slotsEl.querySelectorAll('[data-mini-x]').forEach(function(b){b.addEventListener('click',function(e){e.stopPropagation();var mm=null;minis.forEach(function(m){if(m.handle===b.dataset.miniX)mm=m;});if(mm)miniDec(mm);});});
    slotsEl.querySelectorAll('[data-mini-p]').forEach(function(b){b.addEventListener('click',function(e){e.stopPropagation();var mm=null;minis.forEach(function(m){if(m.handle===b.dataset.miniP)mm=m;});if(mm)miniAdd(mm);});});
    slotsEl.querySelectorAll('[data-mini-zoom]').forEach(function(el){el.addEventListener('click',function(e){
