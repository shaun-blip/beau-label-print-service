  var claimMode=false, cartLooseCents=0, cartItemsView=[];   // loose = eligible wrap lines already in the cart (no _bb); shown read-only in the tray
  var resolveCache=new Map();
  var wasUnlocked=false, inited=false, guardPassed=false, taughtAdd=false, adding=false;

  // pool sources (both bottles) + curated bundles + suggestion cap
  var PROSECCO_COL=root.dataset.source||'la-marca-wraps';
  var CHAMP_COL=root.dataset.champagne||'champagne-collection';
  var WINE_COL=root.dataset.wine||'wine-collection';
  var MAXSUGG=40;
  // Curated starting-bundle pills, keyed to the AI-classified taxonomy (motif-/color-/season-/occasion-/style-/for-).
