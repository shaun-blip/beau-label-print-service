  /* layout */
  .bb-bb-grid-tray{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start}
  .bb-bb-card__zoom{position:absolute;bottom:6px;right:6px;z-index:4;width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:999px;color:var(--ink);background:rgba(255,255,255,.96);border:1px solid var(--line);box-shadow:0 1px 5px rgba(43,47,61,.25);opacity:0;transition:opacity .15s;cursor:zoom-in;padding:0}
