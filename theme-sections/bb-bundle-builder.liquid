  .bb-bb-chip.is-active{background:var(--ink);color:#FFFDF8}
  .bb-bb-resultcount,.bb-bb-help,.bb-bb-scope{font-family:var(--baseFont);color:var(--muted)}
  .bb-bb-scope__b{color:var(--ink)}
