  @keyframes bbBarPulse{0%{transform:scale(1)}35%{transform:scale(1.06)}100%{transform:scale(1)}}
  .bb-bb-stickybar.is-pulse{animation:bbBarPulse .5s ease}
  .bb-bb-sheet{display:none}
  .bb-bb-findbar{display:none}
  @media (max-width:800px){
    .bb-bb-grid-tray{grid-template-columns:1fr}
    /* the tray is a bottom SHEET on mobile — collapsed to the sticky bar, expands over the page */
    .bb-bb-tray{position:fixed;left:0;right:0;bottom:0;top:auto;z-index:99986;margin:0;max-height:76vh;overflow-y:auto;-webkit-overflow-scrolling:touch;border-radius:18px 18px 0 0;box-shadow:0 -12px 44px rgba(23,26,34,.45);transform:translateY(112%);transition:transform .32s cubic-bezier(.2,.8,.2,1);padding-bottom:calc(22px + env(safe-area-inset-bottom,0px))}
    .bb-bb.is-tray-open .bb-bb-tray{transform:none}
