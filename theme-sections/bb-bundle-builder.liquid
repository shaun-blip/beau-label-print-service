  var fillRestBtn=root.querySelector('[data-bb-fillrest]');
  var addBtn=root.querySelector('[data-bb-add]');
  var guardEl=root.querySelector('[data-bb-guard]');
  var noteEl=root.querySelector('[data-bb-note]');
  var nudgeEl=root.querySelector('[data-bb-nudge]');
  var shipEl=root.querySelector('[data-bb-ship]');
  var confettiEl=root.querySelector('[data-bb-confetti]');
  var flipbar=root.querySelector('[data-bb-flip]');
  var searchEl=root.querySelector('[data-bb-search]');
  var clearEl=root.querySelector('[data-bb-search-clear]');
  var chipsEl=root.querySelector('[data-bb-chips]');
  var countEl=root.querySelector('[data-bb-resultcount]');
  // Mobile feedback layer: flash() writes into the tray, which is COLLAPSED on phones, so every
  // message (errors, claim banners, unlocks) was invisible there. A toast above the sticky bar
  // mirrors them, and a progress strip on the bar shows the distance to the next free-wrap tier.
  var toastEl=null,toastT=0,prevFreeN=0;
