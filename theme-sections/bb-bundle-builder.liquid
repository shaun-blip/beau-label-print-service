      else if(s.bottleType){foot='<span class="bb-bb-slot__type">'+s.bottleType+'</span>';}
    } else if(isFree&&locked){inner+='<span class="bb-bb-slot__lockv"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-1px"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><br>FREE</span>';}
    else if(isFree){inner+='<span class="bb-bb-slot__free">FREE<br><s>'+money(UNIT)+'</s></span>';}
    else{inner+='+';}
