  // ---- slot engine (paid[] + free[]) ----
  function toSlot(p){var v=p.variants[0];return {handle:p.handle,bottleType:bottleOf(p.handle),variantId:v.id,title:p.title,img:(p.images&&p.images[0]?p.images[0].src:''),price:toCents(v.price),_busy:false};}
