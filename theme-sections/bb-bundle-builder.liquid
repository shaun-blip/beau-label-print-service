  }
  function render(){
    hideGuard();   // any state change invalidates a pending "free wraps left" prompt
    if(free.length>freeCount())free=free.slice(0,freeCount());   // spend dropped below a tier — release the extra free picks
    var fc=freeCount(),html='';
    var setsN=0;minis.forEach(function(m){setsN+=(minisQty[m.handle]||0);});
    var haveAny=paid.length>0||free.length>0||setsN>0;
    if(adding){save();return;}   // checkout in flight — keep the "Adding…" button state untouched
    // wraps already in the cart: ONE compact line — they count toward the tiers, never touched
    if(haveAny||cartItemsView.length){
      html+='<div class="bb-tiles">';
      // wraps from the cart come over as visible tiles — counted toward the tiers, cart untouched
      cartItemsView.forEach(function(ci){
        html+='<div class="bb-tl bb-tl--cart"><span class="bb-tl__imgw"><img src="'+withW(ci.img,160)+'" alt=""><span class="bb-tl__carttag">IN CART</span>'+(ci.qty>1?'<span class="bb-tl__qty">×'+ci.qty+'</span>':'')+'<button class="bb-tl__x" data-cart-x="'+ci.key+'" aria-label="Remove from cart">×</button></span><span class="bb-tl__ft">'+money(ci.price)+'</span></div>';
