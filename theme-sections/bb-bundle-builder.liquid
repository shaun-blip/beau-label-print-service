  .bb-bb-card.is-added .bb-bb-card__minus{display:flex}
  .bb-bb-card.is-added{border-color:#2e7d57;box-shadow:0 0 0 2px #2e7d57}
  .bb-bb-card.is-added .bb-bb-card__chk{color:#fff;background:#2e7d57;border-color:#2e7d57}
