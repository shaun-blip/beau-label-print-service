  .bb-bb-guard{margin-top:10px;background:var(--rose-tint);border:1px solid var(--rose);border-radius:10px;padding:12px;font-family:var(--baseFont,system-ui,sans-serif);font-size:12px;color:var(--ink);text-align:center}
