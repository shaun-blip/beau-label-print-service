  var paidTarget=parseInt(root.dataset.defaultSize,10)||10;
  var currentBottle=root.dataset.defaultBottle||'Prosecco';
  var paid=[], free=[];          // each: {handle,bottleType,variantId,title,img,price(cents),_busy}
  var pool=[], lastView=[];
  var query='',qtokens=[],activeTags={},chipData=[],seedHandles=[],urlSized=false,userSized=false,stageSeeding=true;
  // CLAIM MODE (?claim=1 — cart banners link here): the shopper's existing cart spend
  // already earned free wraps; show ONLY free slots, no pack required. Picking a size
