  .bb-bb-slot__type{display:block;text-align:center;font-family:var(--baseFont,system-ui,sans-serif);font-size:9px;font-weight:700;letter-spacing:.02em;color:var(--muted);line-height:1.2}
  .bb-bb-slot__switch{display:flex;align-items:center;justify-content:center;gap:4px;width:100%;font-family:var(--baseFont,system-ui,sans-serif);font-size:9px;font-weight:700;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:6px;padding:4px 2px;cursor:pointer;line-height:1.2;white-space:nowrap}
