  var reduceMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function flyToTray(src,from){
    if(reduceMotion||!src)return;
    var filled=slotsEl.querySelectorAll('.bb-it img,.bb-tl__imgw img');
    var target=filled.length?filled[filled.length-1]:null;
    if(isMobile()&&!root.classList.contains('is-tray-open'))target=stickyCountEl||target;   // sheet collapsed: land on the bar
    if(!target)return;
    var to=target.getBoundingClientRect();
    var ghost=document.createElement('img');ghost.src=src;
    ghost.style.cssText='position:fixed;z-index:9999;pointer-events:none;object-fit:contain;border-radius:2px;'+
      'left:'+from.left+'px;top:'+from.top+'px;width:'+from.width+'px;height:'+from.height+'px;'+
      'transition:all .32s cubic-bezier(.2,.7,.3,1);will-change:transform,left,top,width,height;';
    document.body.appendChild(ghost);
    requestAnimationFrame(function(){requestAnimationFrame(function(){
      ghost.style.left=to.left+'px';ghost.style.top=to.top+'px';ghost.style.width=to.width+'px';ghost.style.height=to.height+'px';ghost.style.opacity='.25';
    });});
    setTimeout(function(){ghost.remove();},380);
  }
  var lastPrice=0;
  function tickPrice(el,cents){
    if(reduceMotion||Math.abs(cents-lastPrice)<1){el.textContent=money(cents);lastPrice=cents;return;}
    var fromC=lastPrice,t0=performance.now();lastPrice=cents;
    (function step(now){
      var k=Math.min(1,(now-t0)/240);var v=fromC+(cents-fromC)*(1-Math.pow(1-k,3));
      el.textContent=money(Math.round(v));
      if(k<1)requestAnimationFrame(step);
    })(t0);
  }
  // compact tray tile: thumbnail + × + optional ⇄ foot; tap the image to see it big
  function wrapTile(arrKey,idx,st,isFree){
    var altB=st.bottleType==='Prosecco'?'Champagne':'Prosecco';
    var foot=altSibling(st.handle)?('<button type="button" class="bb-tl__sw bb-tl__sw--btn" data-bt-arr="'+arrKey+'" data-bt-idx="'+idx+'" data-bt="'+altB+'" title="This design also comes in '+altB+' — tap to switch this wrap">⇄ '+abbr(altB)+'</button>'):('<span class="bb-tl__ft">'+abbr(st.bottleType)+'</span>');
