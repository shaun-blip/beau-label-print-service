  .bb-bb-clearall{background:transparent;border:none;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);text-decoration:underline;text-underline-offset:3px;padding:0;font-weight:500}
  .bb-bb-tray__grabbar{background:rgba(27,36,64,.3)}
